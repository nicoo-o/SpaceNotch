<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Greffon d'exemple.

    Il ne référence QUE NotchFlow.Core, et c'est le point important : c'est la
    seule dépendance dont un greffon tiers a besoin. Aucune bibliothèque Windows,
    aucune référence à l'application, aucune à ses fenêtres. Le contrat suffit.

    Un greffon distribué hors de ce dépôt remplacerait la référence de projet par
    une référence à l'assemblage NotchFlow.Core.dll. Le ciblage, lui, ne change
    pas : il doit être compatible avec celui de l'hôte.
  -->
  <PropertyGroup>
    <RootNamespace>NotchFlow.SamplePlugin.Weather</RootNamespace>
    <AssemblyName>NotchFlow.SamplePlugin.Weather</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NotchFlow.Core\NotchFlow.Core.csproj" />
  </ItemGroup>

</Project>
