<?xml version="1.0" encoding="utf-8"?>
<!--
  Paquet d'identité de SpaceNotch (ADR-023).

  Un paquet « à emplacement externe » : il ne contient que ce manifeste et trois
  logos ; les fichiers de l'application restent là où l'installeur les a mis.
  Il donne à SpaceNotch.exe une identité de paquet, sans laquelle Windows
  refuse l'écoute des notifications (UserNotificationListener).

  Signé par le workflow Release avec un certificat éphémère (CN=SpaceNotch) : créé
  pour la version, sa clé privée est détruite après la signature. L'installeur fait
  confiance au certificat public livré à côté du paquet. (Un paquet non signé est
  impossible ici : Windows refuse l'éditeur des paquets non signés dans le
  manifeste d'un exécutable — vérifié par tools/identity-probe.)

  __VERSION__ est remplacé par la version publiée (x.y.z.0) au moment du
  paquetage, dans le workflow Release.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:systemai="http://schemas.microsoft.com/appx/manifest/systemai/windows10"
  IgnorableNamespaces="uap uap3 uap10 rescap systemai">

  <Identity
    Name="SpaceNotch.Identity"
    Publisher="CN=SpaceNotch"
    Version="__VERSION__"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>SpaceNotch</DisplayName>
    <PublisherDisplayName>SpaceNotch</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>

  <Resources>
    <Resource Language="fr-fr" />
    <Resource Language="en-us" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
    <uap3:Capability Name="userNotificationListener" />
    <!-- Prochain rendez-vous (F2) : lecture seule du calendrier. Voir ADR-011. -->
    <uap:Capability Name="appointments" />
    <!-- Modèle local de Windows (Phi Silica, PC Copilot+) pour le résumé et les actions sur copie. Voir ADR-025. -->
    <systemai:Capability Name="systemAIModels" />
    <!-- Miroir avant une réunion (W5) : la webcam, seulement au survol de « Rejoindre ». Voir ADR-026. -->
    <DeviceCapability Name="webcam" />
  </Capabilities>

  <Applications>
    <Application
      Id="SpaceNotch"
      Executable="SpaceNotch.exe"
      uap10:TrustLevel="mediumIL"
      uap10:RuntimeBehavior="win32App">
      <uap:VisualElements
        AppListEntry="none"
        DisplayName="SpaceNotch"
        Description="La notch de Windows"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>
</Package>
