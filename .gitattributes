* text=auto eol=lf

# Sources C# et fichiers projet : LF
*.cs      text diffs=csharp
*.csproj  text eol=lf
*.props   text eol=lf
*.targets text eol=lf
*.sln     text eol=crlf

# Fichiers Windows qui exigent historiquement du CRLF
*.xaml      text eol=crlf
*.manifest  text eol=crlf
*.appxmanifest text eol=crlf
*.ps1       text eol=crlf

# Binaires
*.png   binary
*.jpg   binary
*.ico   binary
*.gif   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.zip   binary
*.nupkg binary

# Les fichiers générés ne polluent pas les stats ni les diffs
*.Designer.cs linguist-generated=true
