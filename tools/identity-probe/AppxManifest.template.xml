<?xml version="1.0" encoding="utf-8"?>
<!--
  Paquet d'identité de SpaceNotch (ADR-023).

  Un paquet « à emplacement externe » : il ne contient que ce manifeste et trois
  logos ; les fichiers de l'application restent là où l'installeur les a mis.
  Il donne à SpaceNotch.exe une identité de paquet, sans laquelle Windows
  refuse l'écoute des notifications (UserNotificationListener).

  Non signé : l'éditeur porte l'OID réservé aux paquets non signés, que
  Windows 11 accepte avec AddPackageOptions.AllowUnsigned. Aucun certificat,
  aucune clé privée à protéger.

  __VERSION__ est remplacé par la version publiée (x.y.z.0) au moment du
  paquetage, dans le workflow Release.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap10 rescap">

  <Identity
    Name="SpaceNotch.Probe"
    Publisher="__PUBLISHER__"
    Version="1.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>SpaceNotch</DisplayName>
    <PublisherDisplayName>SpaceNotch</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>

  <Resources>
    <Resource Language="fr-fr" />
    <Resource Language="en-us" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
    <uap3:Capability Name="userNotificationListener" />
  </Capabilities>

  <Applications>
    <Application
      Id="Probe"
      Executable="Probe.exe"
      uap10:TrustLevel="mediumIL"
      uap10:RuntimeBehavior="win32App">
      <uap:VisualElements
        AppListEntry="none"
        DisplayName="SpaceNotch"
        Description="La notch de Windows"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>
</Package>
