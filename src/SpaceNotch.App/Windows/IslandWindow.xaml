<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="SpaceNotch_App.Windows.IslandWindow"
    xmlns:l="using:SpaceNotch_App.Views"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:winuiex="using:WinUIEx"
    xmlns:scenes="using:SpaceNotch_App.Views.Scenes"
    xmlns:views="using:SpaceNotch_App.Views"
    Title="SpaceNotch"
    mc:Ignorable="d">

    <!--
        Fond transparent déclaré en XAML et piloté par nom : c'est le rendu de
        référence, celui qui laisse le bureau traverser la dissolution. Les
        autres modes sont appliqués à l'exécution depuis ApplyBackdropMode.
    -->
    <Window.SystemBackdrop>
        <winuiex:TransparentTintBackdrop x:Name="TransparentBackdrop" />
    </Window.SystemBackdrop>

    <!--
        Surface interactive. Sa taille est exactement celle de l'Island : elle ne
        déborde jamais d'une marge, donc elle ne capture jamais un clic hors de
        l'Island. Le halo, l'ombre et la dissolution qui rayonnent autour vivent
        dans AtmosphereWindow, qui est clic-traversante (voir ADR-006).
    -->
    <Grid x:Name="RootLayout" Background="Transparent">
        <!--
            Aucun CornerRadius ici, et ce n'est pas un oubli : la silhouette est un
            tracé, pas un rectangle arrondi. C'est une notch TopAttached — bord
            haut collé à l'écran, épaules concaves, grands congés en bas — et
            un rayon de bord ne sait décrire ni les épaules ni la superellipse.
            Voir IslandShape, NotchGeometry et ADR-017.

            Deux tracés se superposent, et c'est voulu :
            — SurfaceFill porte la teinte et la dissolution ;
            — SpecularFill porte la lumière rasante du haut, découpée à la hauteur
              de la bande.

            Ils sont tracés plutôt que posés en fond, parce qu'un tracé est
            anticrénelé par nature : c'est ce qui garantit un congé lisse, là où
            un masque de mise en page produirait un escalier visible à petit
            rayon.
        -->
        <!--
            La goutte qui relie encore la notch au bord quand on l'arrache, puis
            quand elle s'y raccroche : la trace restée au bord et le fil qui se
            rompt. Même matière que la surface, tracée dans le repère de la
            fenêtre. Invisible le reste du temps. Voir ADR-019.
        -->
        <Path
            x:Name="GooFill"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsHitTestVisible="False"
            Visibility="Collapsed" />

        <Grid
            x:Name="IslandBody"
            VerticalAlignment="Top"
            HorizontalAlignment="Center"
            Width="80"
            Height="18"
            Background="Transparent"
            AllowDrop="True"
            PointerEntered="OnIslandPointerEntered"
            PointerExited="OnIslandPointerExited"
            PointerPressed="OnIslandPointerPressed"
            PointerReleased="OnIslandPointerReleased"
            PointerCaptureLost="OnIslandPointerCaptureLost"
            PointerWheelChanged="OnIslandPointerWheelChanged"
            KeyDown="OnIslandKeyDown"
            IsTabStop="True"
            DragOver="OnIslandDragOver"
            DragLeave="OnIslandDragLeave"
            Drop="OnIslandDrop">

            <Path
                x:Name="SurfaceFill"
                HorizontalAlignment="Left"
                VerticalAlignment="Top" />

            <Path
                x:Name="SpecularFill"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Fill="{ThemeResource NfSpecularBrush}"
                Opacity="{ThemeResource NfSpecularOpacity}"
                IsHitTestVisible="False" />

            <!-- Pomodoro autour de la silhouette (F11) : un U rentré dans la forme, qui se raccourcit vers le bas. -->
            <Path
                x:Name="FocusTrace"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                StrokeThickness="1.5"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round"
                StrokeLineJoin="Round"
                Opacity="0.7"
                Visibility="Collapsed"
                IsHitTestVisible="False" />

            <!--
                Le contenu se superpose aux tracés dans l'ordre de déclaration :
                un contrôle d'une scène ouverte reçoit donc le pointeur avant la
                surface. Partout ailleurs, c'est un tracé qui est touché, et
                l'événement remonte jusqu'aux gestionnaires du corps — d'où le
                fait que le survol et le clic fonctionnent sans qu'aucun élément
                n'ait à être rendu transparent au pointeur.
            -->
            <Grid
                x:Name="ContentArea"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch">

                <!--
                    Voix de la notch pour Narrateur. Invisible mais présente dans
                    l'arbre d'accessibilité : un élément replié n'y figure pas, et
                    une notch purement visuelle ne dirait jamais qu'un
                    téléchargement a fini ou qu'un appel arrive.
                -->
                <TextBlock
                    x:Name="AnnouncerText"
                    Width="1"
                    Height="1"
                    Opacity="0"
                    IsHitTestVisible="False"
                    AutomationProperties.LiveSetting="Polite"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top" />

                <!-- ====================================================
                     PALIER VEILLE (Hidden) — une lèvre au bord de l'écran.
                     Vide par défaut : le point n'apparaît qu'avec l'heure,
                     parce qu'une notch sans activité n'a rien à dire.
                     ==================================================== -->
                <StackPanel
                    x:Name="IdleRestView"
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

                    <!-- Pixel (P1) : deux yeux qui suivent le curseur, clignent et dorment la nuit. -->
                    <views:PixelEyesView
                        x:Name="RestEyes"
                        Visibility="Collapsed" />

                    <Ellipse
                        x:Name="IdleStatusDot"
                        Width="{StaticResource NfIdleDotSize}"
                        Height="{StaticResource NfIdleDotSize}"
                        VerticalAlignment="Center" />

                    <!-- L'heure n'est pas un contenu de veille par défaut : elle
                         introduirait une horloge à la minute là où le produit
                         promet de ne rien faire au repos. -->
                    <!-- Horloge à palettes en pixels (M1) : la palette qui change bascule. -->
                    <views:PixelClockView
                        x:Name="IdleClock"
                        Tint="{ThemeResource NfTextSecondaryBrush}"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />

                    <!-- Aperçu météo (F10) : au survol du repos, l'icône vivante et la température. -->
                    <views:GlyphView
                        x:Name="WeatherGlyph"
                        Size="12"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        Tint="{ThemeResource NfTextPrimaryBrush}"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="WeatherText"
                        FontSize="12"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource NfTextPrimaryBrush}"
                        Visibility="Collapsed" />
                </StackPanel>

                <!-- Visage du repos (transition C) : les deux pixels qui vont
                     des yeux aux deux-points de l'heure, et retour. -->
                <Canvas x:Name="FaceMorphLayer" IsHitTestVisible="False" />

                <!-- File d'attente visible (vague 7) : un point par activité qui attend son tour,
                     dans le bas de la notch (une seule notch, voir ADR-017). -->
                <StackPanel
                    x:Name="QueueDotsRow"
                    Orientation="Horizontal"
                    Spacing="4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,4"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />

                <!-- Annuler en 3 s (vague 7) : ce qui vient d'être écarté se rattrape d'un clic. -->
                <StackPanel
                    x:Name="UndoRestView"
                    Spacing="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="UndoText"
                        FontSize="11.5"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource NfTextPrimaryBrush}" />
                    <Border Height="2" CornerRadius="1" Background="#FF7FE6FF" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="UndoBarScale" ScaleX="1" />
                        </Border.RenderTransform>
                    </Border>
                </StackPanel>

                <!-- Aide des gestes (vague 7) : survol avec Alt, les gestes utiles ici. -->
                <StackPanel
                    x:Name="GestureHelpRow"
                    Orientation="Horizontal"
                    Spacing="6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,8"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />

                <!-- ====================================================
                     PALIER SIGNAL — un glyphe, un nom, sur une ligne.
                     ==================================================== -->
                <Grid
                    x:Name="SignalRestView"
                    Margin="{StaticResource NfSignalPadding}"
                    Visibility="Collapsed">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Glyphe ou matière hypnotique : la même place, jamais les deux.
                         L'hôte hypnotique prend la taille du glyphe, et son halo
                         déborde dans la surface noire. -->
                    <Grid Grid.Column="0" VerticalAlignment="Center">
                        <views:GlyphView
                            x:Name="SignalGlyph"
                            Size="{StaticResource NfSignalGlyphSize}"
                            VerticalAlignment="Center" />

                        <!-- Image de l'activité — une pochette — à la place du glyphe :
                             c'est elle qui grandira dans la scène ouverte. -->
                        <Border
                            x:Name="SignalArtwork"
                            Width="{StaticResource NfSignalGlyphSize}"
                            Height="{StaticResource NfSignalGlyphSize}"
                            CornerRadius="{StaticResource NfCornerArtworkSmall}"
                            Visibility="Collapsed">
                            <Image x:Name="SignalArtworkImage" Stretch="UniformToFill" />
                        </Border>

                        <Grid
                            x:Name="SignalHypnoticHost"
                            Width="{StaticResource NfSignalGlyphSize}"
                            Height="{StaticResource NfSignalGlyphSize}"
                            IsHitTestVisible="False"
                            Visibility="Collapsed" />

                        <!-- Pixel, avatar des agents (ADR-029), à la place de la grille. -->
                        <views:PixelAvatarView
                            x:Name="SignalAvatar"
                            VerticalAlignment="Center"
                            Visibility="Collapsed" />
                    </Grid>

                    <TextBlock
                        x:Name="SignalLabel"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Style="{StaticResource NfSignalLabelStyle}"
                        VerticalAlignment="Center" />

                    <!-- Emplacement trailing : la mesure à droite de l'identité —
                         « 62 % », « 12 Mo », « ✓ » — son élément vivant, puis la pile. -->
                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="6"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center">

                        <!-- Fil de niveau d'un retour système : le volume se
                             constate d'un coup d'œil, sans ouvrir la notch. -->
                        <Grid
                            x:Name="SignalLevel"
                            Width="36"
                            Height="3"
                            CornerRadius="1.5"
                            Background="{ThemeResource NfStrokeStrongBrush}"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                            <Border
                                CornerRadius="1.5"
                                Background="{ThemeResource NfTextPrimaryBrush}"
                                RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="SignalLevelScale" ScaleX="0" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>

                        <TextBlock
                            x:Name="SignalMetric"
                            Style="{StaticResource NfMetricTextStyle}"
                            VerticalAlignment="Center"
                            Visibility="Collapsed" />

                        <!-- Anneau, arc de batterie ou égaliseur : l'activité vit. -->
                        <views:TrailingView x:Name="SignalTrailing" VerticalAlignment="Center" />

                        <TextBlock
                            x:Name="SignalStackIndicator"
                            Style="{StaticResource NfMicroTextStyle}"
                            VerticalAlignment="Center"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Grid>

                <!-- ====================================================
                     PALIER CARTE — deux lignes : ce qui se passe, et où.

                     La légende est au-dessus et le titre en dessous, comme dans
                     la référence retenue : le contexte se lit d'abord, la
                     nouvelle ensuite. C'est aussi l'ordre dans lequel une
                     information se raconte.
                     ==================================================== -->
                <Grid
                    x:Name="CardRestView"
                    Margin="{StaticResource NfCardPadding}"
                    ColumnSpacing="10"
                    Visibility="Collapsed">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" VerticalAlignment="Center">
                        <views:GlyphView
                            x:Name="CardGlyph"
                            Size="{StaticResource NfCardGlyphSize}"
                            VerticalAlignment="Center" />

                        <Border
                            x:Name="CardArtwork"
                            Width="{StaticResource NfCardGlyphSize}"
                            Height="{StaticResource NfCardGlyphSize}"
                            CornerRadius="{StaticResource NfCornerArtworkSmall}"
                            Visibility="Collapsed">
                            <Image x:Name="CardArtworkImage" Stretch="UniformToFill" />
                        </Border>

                        <Grid
                            x:Name="CardHypnoticHost"
                            Width="{StaticResource NfCardGlyphSize}"
                            Height="{StaticResource NfCardGlyphSize}"
                            IsHitTestVisible="False"
                            Visibility="Collapsed" />

                        <views:PixelAvatarView
                            x:Name="CardAvatar"
                            VerticalAlignment="Center"
                            Visibility="Collapsed" />
                    </Grid>

                    <StackPanel
                        Grid.Column="1"
                        Spacing="{StaticResource NfCardLineGap}"
                        VerticalAlignment="Center">

                        <TextBlock
                            x:Name="CardSubhead"
                            Style="{StaticResource NfCardSubheadStyle}" />

                        <TextBlock
                            x:Name="CardHeadline"
                            Style="{StaticResource NfCardHeadlineStyle}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center">

                        <TextBlock
                            x:Name="CardMetric"
                            Style="{StaticResource NfMetricTextStyle}"
                            VerticalAlignment="Center"
                            Visibility="Collapsed" />

                        <views:TrailingView x:Name="CardTrailing" VerticalAlignment="Center" />

                        <TextBlock
                            x:Name="CardStackIndicator"
                            Style="{StaticResource NfMicroTextStyle}"
                            VerticalAlignment="Center"
                            Visibility="Collapsed" />
                    </StackPanel>
                
                    <!-- Sablier de pixels (P4) : un pixel par pourcent, empilé au fond. -->
                    <views:PixelHeapView
                        x:Name="CardHeap"
                        Grid.ColumnSpan="3"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,-9"
                        Visibility="Collapsed" />
                </Grid>

                <!-- ====================================================
                     LANGUETTE — la notch accrochée à un côté (ADR-020).
                     Pas de texte couché : l'icône ou la grille, et une jauge
                     verticale si l'activité avance. Le contenu se lit à
                     l'ouverture, à l'horizontale.
                     ==================================================== -->
                <StackPanel
                    x:Name="TabRestView"
                    Spacing="6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">

                    <Grid
                        Width="{StaticResource NfSignalGlyphSize}"
                        Height="{StaticResource NfSignalGlyphSize}"
                        HorizontalAlignment="Center">
                        <views:GlyphView
                            x:Name="TabGlyph"
                            Size="{StaticResource NfSignalGlyphSize}" />
                        <Grid
                            x:Name="TabHypnoticHost"
                            IsHitTestVisible="False"
                            Visibility="Collapsed" />
                    </Grid>

                    <Border
                        x:Name="TabLevel"
                        Width="3"
                        Height="22"
                        CornerRadius="1.5"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource NfStrokeStrongBrush}"
                        Visibility="Collapsed">
                        <Border
                            x:Name="TabLevelFill"
                            Height="0"
                            VerticalAlignment="Bottom"
                            CornerRadius="1.5"
                            Background="{ThemeResource NfTextPrimaryBrush}" />
                    </Border>
                </StackPanel>

                <!-- Scènes : chacune est résolue par la clé déclarée par la fonctionnalité -->
                <scenes:MediaExpandedScene x:Name="MediaSceneView" Visibility="Collapsed" />
                <scenes:VolumeHudScene x:Name="VolumeSceneView" Visibility="Collapsed" />
                <scenes:NotificationScene x:Name="NotificationSceneView" Visibility="Collapsed" />
                <scenes:FileShelfScene x:Name="FileShelfSceneView" Visibility="Collapsed" />
                <scenes:TimerScene x:Name="TimerSceneView" Visibility="Collapsed" />
                <scenes:ClipStackScene x:Name="ClipStackSceneView" Visibility="Collapsed" />
                <scenes:ClipboardScene x:Name="ClipboardSceneView" Visibility="Collapsed" />
                <scenes:LauncherScene x:Name="LauncherSceneView" Visibility="Collapsed" />
                <scenes:QuickMenuScene x:Name="QuickMenuSceneView" Visibility="Collapsed" />
                <scenes:BluetoothScene x:Name="BluetoothSceneView" Visibility="Collapsed" />
                <scenes:WelcomeScene x:Name="WelcomeSceneView" Visibility="Collapsed" />
                <scenes:InfoScene x:Name="InfoSceneView" Visibility="Collapsed" />
                <scenes:ColorScene x:Name="ColorSceneView" Visibility="Collapsed" />
                <scenes:NoteScene x:Name="NoteSceneView" Visibility="Collapsed" />
                <scenes:QuietScene x:Name="QuietSceneView" Visibility="Collapsed" />
                <scenes:MonitorScene x:Name="MonitorSceneView" Visibility="Collapsed" />
                <scenes:ShareScene x:Name="ShareSceneView" Visibility="Collapsed" />

                <!--
                    Cible de dépôt de fichiers. Pendant le survol d'un fichier, la
                    notch s'agrandit et la matière hypnotique « Drop » attire vers
                    le centre ; au dépôt, elle converge et pulse (« Complete »)
                    avant de rendre la main à l'étagère. Le glyphe fixe n'est que
                    le repli, si le compositeur refuse la matière.
                -->
                <StackPanel
                    x:Name="DropZoneView"
                    Visibility="Collapsed"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="{StaticResource NfSpace4}">

                    <Grid
                        Width="{StaticResource NfHypnoticDropSize}"
                        Height="{StaticResource NfHypnoticDropSize}"
                        HorizontalAlignment="Center">

                        <views:GlyphView
                            x:Name="DropGlyph"
                            Key="Download"
                            Size="21"
                            Tint="{ThemeResource NfAccentBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />

                        <Grid
                            x:Name="DropHypnoticHost"
                            IsHitTestVisible="False" />
                    </Grid>

                    <TextBlock
                        Text="{l:Loc Fr='Déposez ici', En='Drop here'}"
                        Style="{StaticResource NfCaptionStrongStyle}"
                        HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!--
                Voile de flou : quand le contenu change, il se lit d'abord flou,
                puis se précise, comme sur la Dynamic Island. C'est un pinceau
                acrylique — le flou natif de Windows — tracé exactement dans la
                silhouette, qui se dissipe par une animation du compositeur.
                Invisible et sans coût le reste du temps. Voir ADR-021.
            -->
            <Path
                x:Name="VeilFill"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                IsHitTestVisible="False"
                Visibility="Collapsed" />

            <!-- Onglets glissants (U2) : plusieurs activités à la fois, une pilule qui glisse. -->
            <views:TabStripView
                x:Name="SceneTabs"
                Margin="0,8,0,0"
                PillBrush="{ThemeResource NfSurfaceElevatedBrush}" />

        </Grid>
    </Grid>
</Window>
