<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="SpaceNotch_App.Windows.IslandWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:winuiex="using:WinUIEx"
    xmlns:scenes="using:SpaceNotch_App.Views.Scenes"
    Title="SpaceNotch"
    mc:Ignorable="d">

    <!--
        Fond transparent déclaré en XAML et piloté par nom : c'est le rendu de
        référence, celui qui laisse le bureau traverser la dissolution. Les
        autres modes sont appliqués à l'exécution depuis ApplyBackdropMode.
    -->
    <Window.SystemBackdrop>
        <winuiex:TransparentTintBackdrop x:Name="TransparentBackdrop" />
    </Window.SystemBackdrop>

    <!--
        Surface interactive. Sa taille est exactement celle de l'Island : elle ne
        déborde jamais d'une marge, donc elle ne capture jamais un clic hors de
        l'Island. Le halo, l'ombre et la dissolution qui rayonnent autour vivent
        dans AtmosphereWindow, qui est clic-traversante (voir ADR-006).
    -->
    <Grid x:Name="RootLayout" Background="Transparent">
        <!--
            Aucun CornerRadius ici, et ce n'est pas un oubli : la silhouette est un
            tracé, pas un rectangle arrondi. C'est une notch TopAttached — bord
            haut collé à l'écran, épaules concaves, grands congés en bas — et
            un rayon de bord ne sait décrire ni les épaules ni la superellipse.
            Voir IslandShape, NotchGeometry et ADR-017.

            Deux tracés se superposent, et c'est voulu :
            — SurfaceFill porte la teinte et la dissolution ;
            — SpecularFill porte la lumière rasante du haut, découpée à la hauteur
              de la bande.

            Ils sont tracés plutôt que posés en fond, parce qu'un tracé est
            anticrénelé par nature : c'est ce qui garantit un congé lisse, là où
            un masque de mise en page produirait un escalier visible à petit
            rayon.
        -->
        <Grid
            x:Name="IslandBody"
            VerticalAlignment="Top"
            HorizontalAlignment="Center"
            Width="80"
            Height="18"
            Background="Transparent"
            AllowDrop="True"
            PointerEntered="OnIslandPointerEntered"
            PointerExited="OnIslandPointerExited"
            PointerPressed="OnIslandPointerPressed"
            PointerWheelChanged="OnIslandPointerWheelChanged"
            KeyDown="OnIslandKeyDown"
            IsTabStop="True"
            DragOver="OnIslandDragOver"
            DragLeave="OnIslandDragLeave"
            Drop="OnIslandDrop">

            <Path
                x:Name="SurfaceFill"
                HorizontalAlignment="Left"
                VerticalAlignment="Top" />

            <Path
                x:Name="SpecularFill"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Fill="{ThemeResource NfSpecularBrush}"
                Opacity="{ThemeResource NfSpecularOpacity}"
                IsHitTestVisible="False" />

            <!--
                Le contenu se superpose aux tracés dans l'ordre de déclaration :
                un contrôle d'une scène ouverte reçoit donc le pointeur avant la
                surface. Partout ailleurs, c'est un tracé qui est touché, et
                l'événement remonte jusqu'aux gestionnaires du corps — d'où le
                fait que le survol et le clic fonctionnent sans qu'aucun élément
                n'ait à être rendu transparent au pointeur.
            -->
            <Grid
                x:Name="ContentArea"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch">

                <!-- ====================================================
                     PALIER VEILLE (Hidden) — une lèvre au bord de l'écran.
                     Vide par défaut : le point n'apparaît qu'avec l'heure,
                     parce qu'une notch sans activité n'a rien à dire.
                     ==================================================== -->
                <StackPanel
                    x:Name="IdleRestView"
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

                    <Ellipse
                        x:Name="IdleStatusDot"
                        Width="{StaticResource NfIdleDotSize}"
                        Height="{StaticResource NfIdleDotSize}"
                        VerticalAlignment="Center" />

                    <!-- L'heure n'est pas un contenu de veille par défaut : elle
                         introduirait une horloge à la minute là où le produit
                         promet de ne rien faire au repos. -->
                    <TextBlock
                        x:Name="IdleClockText"
                        Style="{StaticResource NfMicroTextStyle}"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />
                </StackPanel>

                <!-- ====================================================
                     PALIER SIGNAL — un glyphe, un nom, sur une ligne.
                     ==================================================== -->
                <Grid
                    x:Name="SignalRestView"
                    Margin="{StaticResource NfSignalPadding}"
                    Visibility="Collapsed">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Glyphe ou matière hypnotique : la même place, jamais les deux.
                         L'hôte hypnotique prend la taille du glyphe, et son halo
                         déborde dans la surface noire. -->
                    <Grid Grid.Column="0" VerticalAlignment="Center">
                        <FontIcon
                            x:Name="SignalGlyph"
                            FontSize="{StaticResource NfSignalGlyphSize}"
                            VerticalAlignment="Center" />

                        <Grid
                            x:Name="SignalHypnoticHost"
                            Width="{StaticResource NfSignalGlyphSize}"
                            Height="{StaticResource NfSignalGlyphSize}"
                            IsHitTestVisible="False"
                            Visibility="Collapsed" />
                    </Grid>

                    <TextBlock
                        x:Name="SignalLabel"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Style="{StaticResource NfSignalLabelStyle}"
                        VerticalAlignment="Center" />

                    <TextBlock
                        x:Name="SignalStackIndicator"
                        Grid.Column="2"
                        Margin="6,0,0,0"
                        Style="{StaticResource NfMicroTextStyle}"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />
                </Grid>

                <!-- ====================================================
                     PALIER CARTE — deux lignes : ce qui se passe, et où.

                     La légende est au-dessus et le titre en dessous, comme dans
                     la référence retenue : le contexte se lit d'abord, la
                     nouvelle ensuite. C'est aussi l'ordre dans lequel une
                     information se raconte.
                     ==================================================== -->
                <Grid
                    x:Name="CardRestView"
                    Margin="{StaticResource NfCardPadding}"
                    ColumnSpacing="10"
                    Visibility="Collapsed">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" VerticalAlignment="Center">
                        <FontIcon
                            x:Name="CardGlyph"
                            FontSize="{StaticResource NfCardGlyphSize}"
                            VerticalAlignment="Center" />

                        <Grid
                            x:Name="CardHypnoticHost"
                            Width="{StaticResource NfCardGlyphSize}"
                            Height="{StaticResource NfCardGlyphSize}"
                            IsHitTestVisible="False"
                            Visibility="Collapsed" />
                    </Grid>

                    <StackPanel
                        Grid.Column="1"
                        Spacing="{StaticResource NfCardLineGap}"
                        VerticalAlignment="Center">

                        <TextBlock
                            x:Name="CardSubhead"
                            Style="{StaticResource NfCardSubheadStyle}" />

                        <TextBlock
                            x:Name="CardHeadline"
                            Style="{StaticResource NfCardHeadlineStyle}" />
                    </StackPanel>

                    <TextBlock
                        x:Name="CardStackIndicator"
                        Grid.Column="2"
                        Style="{StaticResource NfMicroTextStyle}"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />
                </Grid>

                <!-- Scènes : chacune est résolue par la clé déclarée par la fonctionnalité -->
                <scenes:MediaExpandedScene x:Name="MediaSceneView" Visibility="Collapsed" />
                <scenes:VolumeHudScene x:Name="VolumeSceneView" Visibility="Collapsed" />
                <scenes:NotificationScene x:Name="NotificationSceneView" Visibility="Collapsed" />
                <scenes:FileShelfScene x:Name="FileShelfSceneView" Visibility="Collapsed" />
                <scenes:TimerScene x:Name="TimerSceneView" Visibility="Collapsed" />
                <scenes:ClipboardScene x:Name="ClipboardSceneView" Visibility="Collapsed" />
                <scenes:LauncherScene x:Name="LauncherSceneView" Visibility="Collapsed" />
                <scenes:InfoScene x:Name="InfoSceneView" Visibility="Collapsed" />

                <!--
                    Cible de dépôt de fichiers. Pendant le survol d'un fichier, la
                    notch s'agrandit et la matière hypnotique « Drop » attire vers
                    le centre ; au dépôt, elle converge et pulse (« Complete »)
                    avant de rendre la main à l'étagère. Le glyphe fixe n'est que
                    le repli, si le compositeur refuse la matière.
                -->
                <StackPanel
                    x:Name="DropZoneView"
                    Visibility="Collapsed"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="{StaticResource NfSpace4}">

                    <Grid
                        Width="{StaticResource NfHypnoticDropSize}"
                        Height="{StaticResource NfHypnoticDropSize}"
                        HorizontalAlignment="Center">

                        <FontIcon
                            x:Name="DropGlyph"
                            Glyph="&#xE898;"
                            FontSize="18"
                            Foreground="{ThemeResource NfAccentBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />

                        <Grid
                            x:Name="DropHypnoticHost"
                            IsHitTestVisible="False" />
                    </Grid>

                    <TextBlock
                        Text="Déposez ici"
                        Style="{StaticResource NfCaptionStrongStyle}"
                        HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
