                                <TextBlock Text="{l:Loc Fr='Précis par défaut ; « compatible » si les bords scintillent.', En='Precise by default; “compatible” if the edges flicker.'}" Style="{StaticResource NfSettingsDescriptionStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="CompositionToggle" Grid.Column="2" VerticalAlignment="Center" OnContent="" OffContent="" MinWidth="0" Toggled="OnCompositionToggled" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource NfSettingsCardStyle}" Tag="Diagnostics Mesures de performance dans le journal.">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <views:GlyphView Key="Bug" Size="16" Tint="#B8FFFFFF" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Diagnostics" Style="{StaticResource NfSettingsTitleStyle}" />
                                <TextBlock Text="{l:Loc Fr='Mesures de performance dans le journal.', En='Performance measurements in the log.'}" Style="{StaticResource NfSettingsDescriptionStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="DiagnosticsToggle" Grid.Column="2" VerticalAlignment="Center" OnContent="" OffContent="" MinWidth="0" Toggled="OnDiagnosticsToggled" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource NfSettingsCardStyle}" Tag="Fichiers de SpaceNotch ">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <views:GlyphView Key="Folder" Size="16" Tint="#B8FFFFFF" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{l:Loc Fr='Fichiers de SpaceNotch', En='SpaceNotch files'}" Style="{StaticResource NfSettingsTitleStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8"><Button Style="{StaticResource NfSecondaryButtonStyle}" Content="Configuration" Click="OnOpenConfigClicked" /><Button Style="{StaticResource NfSecondaryButtonStyle}" Content="{l:Loc Fr='Greffons', En='Plugins'}" Click="OnOpenPluginsClicked" /></StackPanel>
                            <TextBlock x:Name="PathText" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" FontSize="10.5" Foreground="#60FFFFFF" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource NfSettingsCardStyle}" Tag="Greffons en attente Un greffon exécute du code : il n&#x27;est chargé qu&#x27;une fois approuvé ici. Effet au prochain démarrage.">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <views:GlyphView Key="Folder" Size="16" Tint="#B8FFFFFF" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{l:Loc Fr='Greffons en attente', En='Pending plugins'}" Style="{StaticResource NfSettingsTitleStyle}" />
                                <TextBlock Text="{l:Loc Fr='Un greffon exécute du code : il n’est chargé qu’une fois approuvé ici. Effet au prochain démarrage.', En='A plugin runs code: it only loads once approved here. Takes effect on next start.'}" Style="{StaticResource NfSettingsDescriptionStyle}" />
                            </StackPanel>
                            
                            <StackPanel x:Name="PendingPluginsHost" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Spacing="6" Margin="0,6,0,0" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource NfSettingsCardStyle}" Tag="Rétablir les valeurs par défaut Apparence, mouvement et comportement reviennent à leur réglage d&#x27;origine.">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <views:GlyphView Key="Reset" Size="16" Tint="#B8FFFFFF" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{l:Loc Fr='Rétablir les valeurs par défaut', En='Restore defaults'}" Style="{StaticResource NfSettingsTitleStyle}" />
                                <TextBlock Text="{l:Loc Fr='Apparence, mouvement et comportement reviennent à leur réglage d’origine.', En='Appearance, motion and behaviour go back to their original settings.'}" Style="{StaticResource NfSettingsDescriptionStyle}" />
                            </StackPanel>
                            <Button Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource NfDangerButtonStyle}" Content="{l:Loc Fr='Rétablir', En='Restore'}" Click="OnResetClicked" />
                        </Grid>
                    </Border>
                </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <TextBlock
                x:Name="StatusText"
                Grid.Row="1"
                FontSize="11.5"
                Foreground="#E0A030"
                TextWrapping="Wrap"
                Margin="28,0,28,12" />
        </Grid>
    </Grid>
</Window>
