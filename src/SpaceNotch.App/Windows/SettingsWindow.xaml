<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="SpaceNotch_App.Windows.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="SpaceNotch — Réglages"
    mc:Ignorable="d">

    <!--
        Réglages (vague 3, visuel w3-reglages validé) : noir OLED comme la notch,
        menu latéral de sept pages, cartes de 62 DIP — icône, titre, une phrase
        simple, contrôle à droite. La recherche filtre les cartes de toutes les
        pages. Les noms des contrôles et leurs gestionnaires sont ceux d'avant :
        la logique de SettingsWindow.xaml.cs n'a pas changé de sens.

        Thème sombre imposé : des contrôles Fluent qui suivraient un Windows en
        thème clair apparaîtraient en pastilles blanches illisibles.
    -->
    <Grid x:Name="RootLayout" Background="#FF050506" RequestedTheme="Dark">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Menu latéral. -->
        <Grid Grid.Column="0" Padding="10,14,10,14" BorderBrush="#0FFFFFFF" BorderThickness="0,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Padding="10,6,10,14">
                <Grid x:Name="BrandLogo" Width="14" Height="14" VerticalAlignment="Center" />
                <TextBlock Text="Réglages" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource NfTextPrimaryBrush}" />
            </StackPanel>

            <TextBox
                x:Name="SearchSettingsBox"
                Grid.Row="1"
                Margin="4,0,4,10"
                PlaceholderText="Rechercher un réglage"
                AutomationProperties.Name="Rechercher un réglage"
                TextChanged="OnSearchSettingsChanged" />

            <StackPanel x:Name="NavPanel" Grid.Row="2" Spacing="2">
                <Button x:Name="NavGeneral" Style="{StaticResource NfNavButtonStyle}" Click="OnNavClicked" AutomationProperties.Name="Général">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="3" Height="16" CornerRadius="1.5" Background="{ThemeResource NfActiveBrush}" Opacity="0" />
                        <FontIcon Grid.Column="1" Glyph="&#xE80F;" FontSize="14" Foreground="#99FFFFFF" />
                        <TextBlock Grid.Column="2" Text="Général" VerticalAlignment="Center" />
                    </Grid>
                </Button>
                <Button x:Name="NavNotch" Style="{StaticResource NfNavButtonStyle}" Click="OnNavClicked" AutomationProperties.Name="Notch">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="3" Height="16" CornerRadius="1.5" Background="{ThemeResource NfActiveBrush}" Opacity="0" />
                        <FontIcon Grid.Column="1" Glyph="&#xE7F8;" FontSize="14" Foreground="#99FFFFFF" />
                        <TextBlock Grid.Column="2" Text="Notch" VerticalAlignment="Center" />
                    </Grid>
                </Button>
                <Button x:Name="NavAppearance" Style="{StaticResource NfNavButtonStyle}" Click="OnNavClicked" AutomationProperties.Name="Apparence">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="3" Height="16" CornerRadius="1.5" Background="{ThemeResource NfActiveBrush}" Opacity="0" />
                        <FontIcon Grid.Column="1" Glyph="&#xE790;" FontSize="14" Foreground="#99FFFFFF" />
                        <TextBlock Grid.Column="2" Text="Apparence" VerticalAlignment="Center" />
                    </Grid>
                </Button>
                <Button x:Name="NavActivities" Style="{StaticResource NfNavButtonStyle}" Click="OnNavClicked" AutomationProperties.Name="Activités">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="3" Height="16" CornerRadius="1.5" Background="{ThemeResource NfActiveBrush}" Opacity="0" />
                        <FontIcon Grid.Column="1" Glyph="&#xE71D;" FontSize="14" Foreground="#99FFFFFF" />
                        <TextBlock Grid.Column="2" Text="Activités" VerticalAlignment="Center" />
                    </Grid>
                </Button>
                <Button x:Name="NavMotion" Style="{StaticResource NfNavButtonStyle}" Click="OnNavClicked" AutomationProperties.Name="Mouvement">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="3" Height="16" CornerRadius="1.5" Background="{ThemeResource NfActiveBrush}" Opacity="0" />
                        <FontIcon Grid.Column="1" Glyph="&#xE945;" FontSize="14" Foreground="#99FFFFFF" />
                        <TextBlock Grid.Column="2" Text="Mouvement" VerticalAlignment="Center" />
                    </Grid>
                </Button>
                <Button x:Name="NavDisplays" Style="{StaticResource NfNavButtonStyle}" Click="OnNavClicked" AutomationProperties.Name="Écrans">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="3" Height="16" CornerRadius="1.5" Background="{ThemeResource NfActiveBrush}" Opacity="0" />
                        <FontIcon Grid.Column="1" Glyph="&#xE7F4;" FontSize="14" Foreground="#99FFFFFF" />
                        <TextBlock Grid.Column="2" Text="Écrans" VerticalAlignment="Center" />
                    </Grid>
                </Button>
                <Button x:Name="NavAbout" Style="{StaticResource NfNavButtonStyle}" Click="OnNavClicked" AutomationProperties.Name="À propos">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="3" Height="16" CornerRadius="1.5" Background="{ThemeResource NfActiveBrush}" Opacity="0" />
                        <FontIcon Grid.Column="1" Glyph="&#xE946;" FontSize="14" Foreground="#99FFFFFF" />
                        <TextBlock Grid.Column="2" Text="À propos" VerticalAlignment="Center" />
                    </Grid>
                </Button>
            </StackPanel>

            <TextBlock x:Name="NavVersionText" Grid.Row="3" FontSize="11.5" Foreground="#66FFFFFF" Margin="12,0,0,0" />
        </Grid>

        <!-- Pages. -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer x:Name="SettingsScroll" Padding="26,22,26,16">
                <StackPanel x:Name="PagesHost" MaxWidth="780" HorizontalAlignment="Stretch">
                    <TextBlock x:Name="SearchHeader" FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource NfTextPrimaryBrush}" Margin="2,0,0,10" Visibility="Collapsed" />
                <StackPanel x:Name="PageGeneral">
                    <TextBlock Text="Général" FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource NfTextPrimaryBrush}" Margin="2,0,0,2" />
                    <TextBlock Text="Ce qui concerne SpaceNotch tout entier." FontSize="12.5" Foreground="#80FFFFFF" TextWrapping="Wrap" Margin="2,0,0,10" />
                    <TextBlock Text="DÉMARRAGE" Style="{StaticResource NfSettingsGroupStyle}" />
                    <Border Style="{StaticResource NfSettingsCardStyle}" Tag="Démarrer avec Windows La notch est là dès l&#x27;ouverture de session.">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <FontIcon Glyph="&#xE7E8;" FontSize="16" Foreground="#B8FFFFFF" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Démarrer avec Windows" Style="{StaticResource NfSettingsTitleStyle}" />
                                <TextBlock Text="La notch est là dès l&#x27;ouverture de session." Style="{StaticResource NfSettingsDescriptionStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="StartupToggle" Grid.Column="2" VerticalAlignment="Center" OnContent="" OffContent="" MinWidth="0" Toggled="OnStartupToggled" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource NfSettingsCardStyle}" Tag="Revoir la présentation Les cinq gestes de la notch, en trente secondes.">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <FontIcon Glyph="&#xE734;" FontSize="16" Foreground="#B8FFFFFF" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Revoir la présentation" Style="{StaticResource NfSettingsTitleStyle}" />
                                <TextBlock Text="Les cinq gestes de la notch, en trente secondes." Style="{StaticResource NfSettingsDescriptionStyle}" />
                            </StackPanel>
                            <Button x:Name="ReplayWelcomeButton" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource NfSecondaryButtonStyle}" Content="Revoir" Click="OnReplayWelcomeClicked" />
                        </Grid>
                    </Border>
                    <TextBlock Text="RECHERCHE" Style="{StaticResource NfSettingsGroupStyle}" />
                    <Border Style="{StaticResource NfSettingsCardStyle}" Tag="Raccourci de la recherche Ouvre et referme la recherche depuis n&#x27;importe quelle application.">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <FontIcon Glyph="&#xE721;" FontSize="16" Foreground="#B8FFFFFF" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Raccourci de la recherche" Style="{StaticResource NfSettingsTitleStyle}" />
                                <TextBlock Text="Ouvre et referme la recherche depuis n&#x27;importe quelle application." Style="{StaticResource NfSettingsDescriptionStyle}" />
                            </StackPanel>
                            <StackPanel x:Name="HotkeyCaps" Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource NfSettingsCardStyle}" Tag="Moteur de recherche web Utilisé quand aucune application ne correspond.">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <FontIcon Glyph="&#xE774;" FontSize="16" Foreground="#B8FFFFFF" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Moteur de recherche web" Style="{StaticResource NfSettingsTitleStyle}" />
                                <TextBlock Text="Utilisé quand aucune application ne correspond." Style="{StaticResource NfSettingsDescriptionStyle}" />
                            </StackPanel>
                            <ComboBox x:Name="WebSearchBox" Grid.Column="2" VerticalAlignment="Center" MinWidth="150" SelectionChanged="OnWebSearchChanged" />
                        </Grid>
                    </Border>
                    <TextBlock Text="NOTIFICATIONS WINDOWS" Style="{StaticResource NfSettingsGroupStyle}" />
                    <Border Style="{StaticResource NfSettingsCardStyle}" Tag="Afficher mes notifications dans la notch Messages, Discord, Teams… Windows demande ton accord une seule fois.">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <FontIcon Glyph="&#xE715;" FontSize="16" Foreground="#B8FFFFFF" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Afficher mes notifications dans la notch" Style="{StaticResource NfSettingsTitleStyle}" />
                                <TextBlock Text="Messages, Discord, Teams… Windows demande ton accord une seule fois." Style="{StaticResource NfSettingsDescriptionStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10"><TextBlock x:Name="NotificationStatusText" FontSize="12" VerticalAlignment="Center" /><Button x:Name="NotificationButton" Style="{StaticResource NfSecondaryButtonStyle}" Click="OnNotificationButtonClicked" /></StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource NfSettingsCardStyle}" Tag="Applications ignorées Leurs notifications restent dans le coin de l&#x27;écran. Tape un nom puis Entrée.">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <FontIcon Glyph="&#xE733;" FontSize="16" Foreground="#B8FFFFFF" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Applications ignorées" Style="{StaticResource NfSettingsTitleStyle}" />
                                <TextBlock Text="Leurs notifications restent dans le coin de l&#x27;écran. Tape un nom puis Entrée." Style="{StaticResource NfSettingsDescriptionStyle}" />
                            </StackPanel>
                            <TextBox x:Name="IgnoredAppBox" Grid.Column="2" VerticalAlignment="Center" Width="180" PlaceholderText="Nom de l'application" KeyDown="OnIgnoredAppKeyDown" />
                            <StackPanel x:Name="IgnoredAppsHost" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0" />
                        </Grid>
                    </Border>
                </StackPanel>
                <StackPanel x:Name="PageNotch" Visibility="Collapsed">
                    <TextBlock Text="Notch" FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource NfTextPrimaryBrush}" Margin="2,0,0,2" />
                    <TextBlock Text="Comment la notch répond, et où elle se tient." FontSize="12.5" Foreground="#80FFFFFF" TextWrapping="Wrap" Margin="2,0,0,10" />
                    <TextBlock Text="SURVOL ET OUVERTURE" Style="{StaticResource NfSettingsGroupStyle}" />
                    <Border Style="{StaticResource NfSettingsCardStyle}" Tag="Aperçu au survol Survoler la notch montre un aperçu de ce qui se passe.">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <FontIcon Glyph="&#xE7C9;" FontSize="16" Foreground="#B8FFFFFF" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Aperçu au survol" Style="{StaticResource NfSettingsTitleStyle}" />
                                <TextBlock Text="Survoler la notch montre un aperçu de ce qui se passe." Style="{StaticResource NfSettingsDescriptionStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="HoverToggle" Grid.Column="2" VerticalAlignment="Center" OnContent="" OffContent="" MinWidth="0" Toggled="OnHoverToggled" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource NfSettingsCardStyle}" Tag="Ouvrir après une seconde de survol Sans cliquer : un survol prolongé ouvre la notch.">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <FontIcon Glyph="&#xE823;" FontSize="16" Foreground="#B8FFFFFF" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Ouvrir après une seconde de survol" Style="{StaticResource NfSettingsTitleStyle}" />
                                <TextBlock Text="Sans cliquer : un survol prolongé ouvre la notch." Style="{StaticResource NfSettingsDescriptionStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="HoverExpandToggle" Grid.Column="2" VerticalAlignment="Center" OnContent="" OffContent="" MinWidth="0" Toggled="OnHoverExpandToggled" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource NfSettingsCardStyle}" Tag="S&#x27;effacer devant le plein écran Jeux, vidéos, présentations : la notch se retire.">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <FontIcon Glyph="&#xE740;" FontSize="16" Foreground="#B8FFFFFF" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="S&#x27;effacer devant le plein écran" Style="{StaticResource NfSettingsTitleStyle}" />
                                <TextBlock Text="Jeux, vidéos, présentations : la notch se retire." Style="{StaticResource NfSettingsDescriptionStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="FullscreenToggle" Grid.Column="2" VerticalAlignment="Center" OnContent="" OffContent="" MinWidth="0" Toggled="OnFullscreenToggled" />
                        </Grid>
                    </Border>
                    <TextBlock Text="POSITION" Style="{StaticResource NfSettingsGroupStyle}" />
                    <Border Style="{StaticResource NfSettingsCardStyle}" Tag="Bord d&#x27;accroche Où la notch s&#x27;accroche à l&#x27;écran.">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <FontIcon Glyph="&#xE8AB;" FontSize="16" Foreground="#B8FFFFFF" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Bord d&#x27;accroche" Style="{StaticResource NfSettingsTitleStyle}" />
                                <TextBlock Text="Où la notch s&#x27;accroche à l&#x27;écran." Style="{StaticResource NfSettingsDescriptionStyle}" />
                            </StackPanel>
                            <ComboBox x:Name="EdgeBox" Grid.Column="2" VerticalAlignment="Center" MinWidth="150" SelectionChanged="OnEdgeChanged" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource NfSettingsCardStyle}" Tag="Accrocher aussi à gauche et à droite En languette verticale sur les côtés.">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <FontIcon Glyph="&#xE89F;" FontSize="16" Foreground="#B8FFFFFF" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Accrocher aussi à gauche et à droite" Style="{StaticResource NfSettingsTitleStyle}" />
                                <TextBlock Text="En languette verticale sur les côtés." Style="{StaticResource NfSettingsDescriptionStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="SideEdgesToggle" Grid.Column="2" VerticalAlignment="Center" OnContent="" OffContent="" MinWidth="0" Toggled="OnSideEdgesToggled" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource NfSettingsCardStyle}" Tag="Détacher en tirant Tire la notch pour en faire une pastille ; double-clic pour la raccrocher.">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <FontIcon Glyph="&#xE896;" FontSize="16" Foreground="#B8FFFFFF" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Détacher en tirant" Style="{StaticResource NfSettingsTitleStyle}" />
                                <TextBlock Text="Tire la notch pour en faire une pastille ; double-clic pour la raccrocher." Style="{StaticResource NfSettingsDescriptionStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="DetachToggle" Grid.Column="2" VerticalAlignment="Center" OnContent="" OffContent="" MinWidth="0" Toggled="OnDetachToggled" />
                        </Grid>
                    </Border>
                    <TextBlock Text="AU REPOS" Style="{StaticResource NfSettingsGroupStyle}" />
                    <Border Style="{StaticResource NfSettingsCardStyle}" Tag="Bulle pour les activités importantes Appel, minuteur terminé : une bulle à côté de la notch.">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <FontIcon Glyph="&#xE8BD;" FontSize="16" Foreground="#B8FFFFFF" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Bulle pour les activités importantes" Style="{StaticResource NfSettingsTitleStyle}" />
                                <TextBlock Text="Appel, minuteur terminé : une bulle à côté de la notch." Style="{StaticResource NfSettingsDescriptionStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="BubbleToggle" Grid.Column="2" VerticalAlignment="Center" OnContent="" OffContent="" MinWidth="0" Toggled="OnBubbleToggled" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource NfSettingsCardStyle}" Tag="Indicateur de pile Des points indiquent qu&#x27;il y a d&#x27;autres activités derrière.">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <FontIcon Glyph="&#xE8FD;" FontSize="16" Foreground="#B8FFFFFF" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Indicateur de pile" Style="{StaticResource NfSettingsTitleStyle}" />
                                <TextBlock Text="Des points indiquent qu&#x27;il y a d&#x27;autres activités derrière." Style="{StaticResource NfSettingsDescriptionStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="StackToggle" Grid.Column="2" VerticalAlignment="Center" OnContent="" OffContent="" MinWidth="0" Toggled="OnStackToggled" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource NfSettingsCardStyle}" Tag="Heure au repos L&#x27;heure dans la notch quand rien ne se passe.">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <FontIcon Glyph="&#xE823;" FontSize="16" Foreground="#B8FFFFFF" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Heure au repos" Style="{StaticResource NfSettingsTitleStyle}" />
                                <TextBlock Text="L&#x27;heure dans la notch quand rien ne se passe." Style="{StaticResource NfSettingsDescriptionStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ClockToggle" Grid.Column="2" VerticalAlignment="Center" OnContent="" OffContent="" MinWidth="0" Toggled="OnClockToggled" />
                        </Grid>
                    </Border>
                </StackPanel>
                <StackPanel x:Name="PageAppearance" Visibility="Collapsed">
                    <TextBlock Text="Apparence" FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource NfTextPrimaryBrush}" Margin="2,0,0,2" />
                    <TextBlock Text="À quoi ressemble la notch. L&#x27;aperçu suit chaque réglage." FontSize="12.5" Foreground="#80FFFFFF" TextWrapping="Wrap" Margin="2,0,0,10" />
                    <Border CornerRadius="10" Background="#08080A" BorderBrush="#12FFFFFF" BorderThickness="1" Margin="0,0,0,8" Padding="0,0,0,0">
