<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="SpaceNotch_App.Windows.SettingsWindow"
    xmlns:l="using:SpaceNotch_App.Views"
    xmlns:views="using:SpaceNotch_App.Views"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="SpaceNotch — Réglages"
    mc:Ignorable="d">

    <!--
        Réglages (vague 3, visuel w3-reglages validé) : noir OLED comme la notch,
        menu latéral de sept pages, cartes de 62 DIP — icône, titre, une phrase
        simple, contrôle à droite. La recherche filtre les cartes de toutes les
        pages. Les noms des contrôles et leurs gestionnaires sont ceux d'avant :
        la logique de SettingsWindow.xaml.cs n'a pas changé de sens.

        Thème sombre imposé : des contrôles Fluent qui suivraient un Windows en
        thème clair apparaîtraient en pastilles blanches illisibles.
    -->
    <Grid x:Name="RootLayout" Background="#FF050506" RequestedTheme="Dark">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Menu latéral. -->
        <Grid x:Name="NavColumn" Grid.Column="0" Padding="10,14,10,14" BorderBrush="#0FFFFFFF" BorderThickness="0,0,1,0" SizeChanged="OnNavColumnSizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Padding="10,6,10,14">
                <Grid x:Name="BrandLogo" Width="14" Height="14" VerticalAlignment="Center" />
                <TextBlock Text="{l:Loc Fr='Réglages', En='Settings'}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource NfTextPrimaryBrush}" />
            </StackPanel>

            <TextBox
                x:Name="SearchSettingsBox"
                Grid.Row="1"
                Margin="4,0,4,10"
                PlaceholderText="{l:Loc Fr='Rechercher un réglage', En='Search settings'}"
                AutomationProperties.Name="{l:Loc Fr='Rechercher un réglage', En='Search settings'}"
                TextChanged="OnSearchSettingsChanged" />

            <!-- La trame de la notch, au cyan du logo, sous le dernier onglet. -->
            <views:TrameView x:Name="NavTrame" Grid.RowSpan="4" />

            <StackPanel Grid.Row="2" Spacing="14">
                <StackPanel x:Name="NavPanel" Spacing="2">
                    <Button x:Name="NavGeneral" Style="{StaticResource NfNavButtonStyle}" Click="OnNavClicked" AutomationProperties.Name="{l:Loc Fr='Général', En='General'}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="3" Height="16" CornerRadius="1.5" Background="{ThemeResource NfActiveBrush}" Opacity="0" />
                            <views:GlyphView Grid.Column="1" Key="Home" Size="14" Tint="#99FFFFFF" />
                            <TextBlock Grid.Column="2" Text="{l:Loc Fr='Général', En='General'}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button x:Name="NavNotch" Style="{StaticResource NfNavButtonStyle}" Click="OnNavClicked" AutomationProperties.Name="Notch">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="3" Height="16" CornerRadius="1.5" Background="{ThemeResource NfActiveBrush}" Opacity="0" />
                            <views:GlyphView Grid.Column="1" Key="Notch" Size="14" Tint="#99FFFFFF" />
                            <TextBlock Grid.Column="2" Text="Notch" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button x:Name="NavAppearance" Style="{StaticResource NfNavButtonStyle}" Click="OnNavClicked" AutomationProperties.Name="{l:Loc Fr='Apparence', En='Appearance'}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="3" Height="16" CornerRadius="1.5" Background="{ThemeResource NfActiveBrush}" Opacity="0" />
                            <views:GlyphView Grid.Column="1" Key="Palette" Size="14" Tint="#99FFFFFF" />
                            <TextBlock Grid.Column="2" Text="{l:Loc Fr='Apparence', En='Appearance'}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button x:Name="NavActivities" Style="{StaticResource NfNavButtonStyle}" Click="OnNavClicked" AutomationProperties.Name="{l:Loc Fr='Activités', En='Activities'}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="3" Height="16" CornerRadius="1.5" Background="{ThemeResource NfActiveBrush}" Opacity="0" />
                            <views:GlyphView Grid.Column="1" Key="Launcher" Size="14" Tint="#99FFFFFF" />
                            <TextBlock Grid.Column="2" Text="{l:Loc Fr='Activités', En='Activities'}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button x:Name="NavMotion" Style="{StaticResource NfNavButtonStyle}" Click="OnNavClicked" AutomationProperties.Name="{l:Loc Fr='Mouvement', En='Motion'}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="3" Height="16" CornerRadius="1.5" Background="{ThemeResource NfActiveBrush}" Opacity="0" />
                            <views:GlyphView Grid.Column="1" Key="Motion" Size="14" Tint="#99FFFFFF" />
                            <TextBlock Grid.Column="2" Text="{l:Loc Fr='Mouvement', En='Motion'}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button x:Name="NavDisplays" Style="{StaticResource NfNavButtonStyle}" Click="OnNavClicked" AutomationProperties.Name="{l:Loc Fr='Écrans', En='Displays'}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="3" Height="16" CornerRadius="1.5" Background="{ThemeResource NfActiveBrush}" Opacity="0" />
                            <views:GlyphView Grid.Column="1" Key="Display" Size="14" Tint="#99FFFFFF" />
                            <TextBlock Grid.Column="2" Text="{l:Loc Fr='Écrans', En='Displays'}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button x:Name="NavAbout" Style="{StaticResource NfNavButtonStyle}" Click="OnNavClicked" AutomationProperties.Name="{l:Loc Fr='À propos', En='About'}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="3" Height="16" CornerRadius="1.5" Background="{ThemeResource NfActiveBrush}" Opacity="0" />
                            <views:GlyphView Grid.Column="1" Key="Info" Size="14" Tint="#99FFFFFF" />
                            <TextBlock Grid.Column="2" Text="{l:Loc Fr='À propos', En='About'}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- La version suit les onglets : le bas du menu reste à la trame. -->
                <TextBlock x:Name="NavVersionText" FontSize="11.5" Foreground="#66FFFFFF" Margin="12,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- Pages. -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer x:Name="SettingsScroll" Padding="26,22,26,16">
                <StackPanel x:Name="PagesHost" MaxWidth="780" HorizontalAlignment="Stretch">
                    <TextBlock x:Name="SearchHeader" FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource NfTextPrimaryBrush}" Margin="2,0,0,10" Visibility="Collapsed" />
                <StackPanel x:Name="PageGeneral">
                    <TextBlock Text="{l:Loc Fr='Général', En='General'}" FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource NfTextPrimaryBrush}" Margin="2,0,0,2" />
                    <TextBlock Text="{l:Loc Fr='Ce qui concerne SpaceNotch tout entier.', En='Everything about SpaceNotch as a whole.'}" FontSize="12.5" Foreground="#80FFFFFF" TextWrapping="Wrap" Margin="2,0,0,10" />
                    <TextBlock Text="{l:Loc Fr='DÉMARRAGE', En='STARTUP'}" Style="{StaticResource NfSettingsGroupStyle}" />
                    <Border Style="{StaticResource NfSettingsCardStyle}" Tag="Démarrer avec Windows La notch est là dès l&#x27;ouverture de session.">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <views:GlyphView Key="Power" Size="16" Tint="#B8FFFFFF" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{l:Loc Fr='Démarrer avec Windows', En='Start with Windows'}" Style="{StaticResource NfSettingsTitleStyle}" />
                                <TextBlock Text="{l:Loc Fr='La notch est là dès l’ouverture de session.', En='The notch is there as soon as you sign in.'}" Style="{StaticResource NfSettingsDescriptionStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="StartupToggle" Grid.Column="2" VerticalAlignment="Center" OnContent="" OffContent="" MinWidth="0" Toggled="OnStartupToggled" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource NfSettingsCardStyle}" Tag="Revoir la présentation Les cinq gestes de la notch, en trente secondes.">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <views:GlyphView Key="Star" Size="16" Tint="#B8FFFFFF" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{l:Loc Fr='Revoir la présentation', En='Replay the tour'}" Style="{StaticResource NfSettingsTitleStyle}" />
                                <TextBlock Text="{l:Loc Fr='Les cinq gestes de la notch, en trente secondes.', En='The notch’s five gestures, in thirty seconds.'}" Style="{StaticResource NfSettingsDescriptionStyle}" />
                            </StackPanel>
                            <Button x:Name="ReplayWelcomeButton" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource NfSecondaryButtonStyle}" Content="{l:Loc Fr='Revoir', En='Replay'}" Click="OnReplayWelcomeClicked" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{l:Loc Fr='RECHERCHE', En='SEARCH'}" Style="{StaticResource NfSettingsGroupStyle}" />
                    <Border Style="{StaticResource NfSettingsCardStyle}" Tag="Raccourci de la recherche Ouvre et referme la recherche depuis n&#x27;importe quelle application.">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <views:GlyphView Key="Search" Size="16" Tint="#B8FFFFFF" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{l:Loc Fr='Raccourci de la recherche', En='Search shortcut'}" Style="{StaticResource NfSettingsTitleStyle}" />
                                <TextBlock Text="{l:Loc Fr='Ouvre et referme la recherche depuis n’importe quelle application.', En='Opens and closes search from any app.'}" Style="{StaticResource NfSettingsDescriptionStyle}" />
                            </StackPanel>
                            <StackPanel x:Name="HotkeyCaps" Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource NfSettingsCardStyle}" Tag="Moteur de recherche web Utilisé quand aucune application ne correspond.">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <views:GlyphView Key="Globe" Size="16" Tint="#B8FFFFFF" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{l:Loc Fr='Moteur de recherche web', En='Web search engine'}" Style="{StaticResource NfSettingsTitleStyle}" />
                                <TextBlock Text="{l:Loc Fr='Utilisé quand aucune application ne correspond.', En='Used when no app matches.'}" Style="{StaticResource NfSettingsDescriptionStyle}" />
                            </StackPanel>
                            <ComboBox x:Name="WebSearchBox" Grid.Column="2" VerticalAlignment="Center" MinWidth="150" SelectionChanged="OnWebSearchChanged" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{l:Loc Fr='NOTIFICATIONS WINDOWS', En='WINDOWS NOTIFICATIONS'}" Style="{StaticResource NfSettingsGroupStyle}" />
                    <Border Style="{StaticResource NfSettingsCardStyle}" Tag="Afficher mes notifications dans la notch Messages, Discord, Teams… Windows demande ton accord une seule fois.">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <views:GlyphView Key="Notification" Size="16" Tint="#B8FFFFFF" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{l:Loc Fr='Afficher mes notifications dans la notch', En='Show my notifications in the notch'}" Style="{StaticResource NfSettingsTitleStyle}" />
                                <TextBlock Text="{l:Loc Fr='Messages, Discord, Teams… Windows demande ton accord une seule fois.', En='Messages, Discord, Teams… Windows asks for your permission once.'}" Style="{StaticResource NfSettingsDescriptionStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10"><TextBlock x:Name="NotificationStatusText" FontSize="12" VerticalAlignment="Center" /><Button x:Name="NotificationButton" Style="{StaticResource NfSecondaryButtonStyle}" Click="OnNotificationButtonClicked" /></StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource NfSettingsCardStyle}" Tag="Applications ignorées Leurs notifications restent dans le coin de l&#x27;écran. Tape un nom puis Entrée.">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <views:GlyphView Key="Block" Size="16" Tint="#B8FFFFFF" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{l:Loc Fr='Applications ignorées', En='Ignored apps'}" Style="{StaticResource NfSettingsTitleStyle}" />
                                <TextBlock Text="{l:Loc Fr='Leurs notifications restent dans le coin de l’écran. Tape un nom puis Entrée.', En='Their notifications stay in the corner of the screen. Type a name, then Enter.'}" Style="{StaticResource NfSettingsDescriptionStyle}" />
                            </StackPanel>
                            <TextBox x:Name="IgnoredAppBox" Grid.Column="2" VerticalAlignment="Center" Width="180" PlaceholderText="{l:Loc Fr='Nom de l’application', En='App name'}" KeyDown="OnIgnoredAppKeyDown" />
                            <StackPanel x:Name="IgnoredAppsHost" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0" />
                        </Grid>
                    </Border>
                </StackPanel>
                <StackPanel x:Name="PageNotch" Visibility="Collapsed">
                    <TextBlock Text="Notch" FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource NfTextPrimaryBrush}" Margin="2,0,0,2" />
                    <TextBlock Text="{l:Loc Fr='Comment la notch répond, et où elle se tient.', En='How the notch responds, and where it sits.'}" FontSize="12.5" Foreground="#80FFFFFF" TextWrapping="Wrap" Margin="2,0,0,10" />
                    <TextBlock Text="{l:Loc Fr='SURVOL ET OUVERTURE', En='HOVER AND OPEN'}" Style="{StaticResource NfSettingsGroupStyle}" />
                    <Border Style="{StaticResource NfSettingsCardStyle}" Tag="Aperçu au survol Survoler la notch montre un aperçu de ce qui se passe.">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <views:GlyphView Key="Pointer" Size="16" Tint="#B8FFFFFF" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{l:Loc Fr='Aperçu au survol', En='Preview on hover'}" Style="{StaticResource NfSettingsTitleStyle}" />
                                <TextBlock Text="{l:Loc Fr='Survoler la notch montre un aperçu de ce qui se passe.', En='Hovering the notch previews what’s going on.'}" Style="{StaticResource NfSettingsDescriptionStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="HoverToggle" Grid.Column="2" VerticalAlignment="Center" OnContent="" OffContent="" MinWidth="0" Toggled="OnHoverToggled" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource NfSettingsCardStyle}" Tag="Ouvrir après une seconde de survol Sans cliquer : un survol prolongé ouvre la notch.">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <views:GlyphView Key="Clock" Size="16" Tint="#B8FFFFFF" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{l:Loc Fr='Ouvrir après une seconde de survol', En='Open after hovering for a second'}" Style="{StaticResource NfSettingsTitleStyle}" />
                                <TextBlock Text="{l:Loc Fr='Sans cliquer : un survol prolongé ouvre la notch.', En='No click needed: a long hover opens the notch.'}" Style="{StaticResource NfSettingsDescriptionStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="HoverExpandToggle" Grid.Column="2" VerticalAlignment="Center" OnContent="" OffContent="" MinWidth="0" Toggled="OnHoverExpandToggled" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource NfSettingsCardStyle}" Tag="S&#x27;effacer devant le plein écran Jeux, vidéos, présentations : la notch se retire.">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <views:GlyphView Key="Fullscreen" Size="16" Tint="#B8FFFFFF" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{l:Loc Fr='S’effacer devant le plein écran', En='Hide in full screen'}" Style="{StaticResource NfSettingsTitleStyle}" />
                                <TextBlock Text="{l:Loc Fr='Jeux, vidéos, présentations : la notch se retire.', En='Games, videos, presentations: the notch steps aside.'}" Style="{StaticResource NfSettingsDescriptionStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="FullscreenToggle" Grid.Column="2" VerticalAlignment="Center" OnContent="" OffContent="" MinWidth="0" Toggled="OnFullscreenToggled" />
                        </Grid>
                    </Border>
                    <TextBlock Text="POSITION" Style="{StaticResource NfSettingsGroupStyle}" />
                    <Border Style="{StaticResource NfSettingsCardStyle}" Tag="Bord d&#x27;accroche Où la notch s&#x27;accroche à l&#x27;écran.">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <views:GlyphView Key="Dock" Size="16" Tint="#B8FFFFFF" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{l:Loc Fr='Bord d’accroche', En='Docking edge'}" Style="{StaticResource NfSettingsTitleStyle}" />
                                <TextBlock Text="{l:Loc Fr='Où la notch s’accroche à l’écran.', En='Where the notch docks on the screen.'}" Style="{StaticResource NfSettingsDescriptionStyle}" />
                            </StackPanel>
                            <ComboBox x:Name="EdgeBox" Grid.Column="2" VerticalAlignment="Center" MinWidth="150" SelectionChanged="OnEdgeChanged" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource NfSettingsCardStyle}" Tag="Accrocher aussi à gauche et à droite En languette verticale sur les côtés.">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <views:GlyphView Key="Side" Size="16" Tint="#B8FFFFFF" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{l:Loc Fr='Accrocher aussi à gauche et à droite', En='Also dock left and right'}" Style="{StaticResource NfSettingsTitleStyle}" />
                                <TextBlock Text="{l:Loc Fr='En languette verticale sur les côtés.', En='As a vertical tab on the sides.'}" Style="{StaticResource NfSettingsDescriptionStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="SideEdgesToggle" Grid.Column="2" VerticalAlignment="Center" OnContent="" OffContent="" MinWidth="0" Toggled="OnSideEdgesToggled" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource NfSettingsCardStyle}" Tag="Détacher en tirant Tire la notch pour en faire une pastille ; double-clic pour la raccrocher.">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <views:GlyphView Key="Detach" Size="16" Tint="#B8FFFFFF" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{l:Loc Fr='Détacher en tirant', En='Pull to detach'}" Style="{StaticResource NfSettingsTitleStyle}" />
                                <TextBlock Text="{l:Loc Fr='Tire la notch pour en faire une pastille ; double-clic pour la raccrocher.', En='Pull the notch to turn it into a pill; double-click to dock it again.'}" Style="{StaticResource NfSettingsDescriptionStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="DetachToggle" Grid.Column="2" VerticalAlignment="Center" OnContent="" OffContent="" MinWidth="0" Toggled="OnDetachToggled" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{l:Loc Fr='AU REPOS', En='AT REST'}" Style="{StaticResource NfSettingsGroupStyle}" />
                    <Border Style="{StaticResource NfSettingsCardStyle}" Tag="Bulle pour les activités importantes Appel, minuteur terminé : une bulle à côté de la notch.">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <views:GlyphView Key="Bubble" Size="16" Tint="#B8FFFFFF" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{l:Loc Fr='Bulle pour les activités importantes', En='Bubble for important activities'}" Style="{StaticResource NfSettingsTitleStyle}" />
                                <TextBlock Text="{l:Loc Fr='Appel, minuteur terminé : une bulle à côté de la notch.', En='A call, a finished timer: a bubble next to the notch.'}" Style="{StaticResource NfSettingsDescriptionStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="BubbleToggle" Grid.Column="2" VerticalAlignment="Center" OnContent="" OffContent="" MinWidth="0" Toggled="OnBubbleToggled" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource NfSettingsCardStyle}" Tag="Indicateur de pile Des points indiquent qu&#x27;il y a d&#x27;autres activités derrière.">
