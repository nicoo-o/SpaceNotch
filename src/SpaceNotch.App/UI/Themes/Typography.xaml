<?xml version="1.0" encoding="utf-8"?>
<!--
    Échelle typographique SpaceNotch.

    Segoe UI Variable expose trois faces optiques — Display, Text, Small — et
    WinUI ne choisit que la famille, jamais la face adaptée au palier. Les
    déclarer explicitement est ce qui distingue un texte simplement affiché d'un
    texte dessiné à la bonne graisse optique : à 9,5 pt, la face Small ouvre le
    contrepoinçon et épaissit les fûts, là où la face Text se referme et devient
    grise.

    La chaîne de repli reste explicite : une machine sans Segoe UI Variable
    (langue non prise en charge, police désinstallée) retombe sur Segoe UI
    plutôt que sur la police générique du système.

    Les paliers sont volontairement resserrés. L'Island est une petite surface :
    une échelle à huit niveaux y serait du décor, pas de la hiérarchie.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Familles. Une seule déclaration, reprise par tous les styles. -->
    <FontFamily x:Key="NfFontDisplay">Segoe UI Variable Display, Segoe UI Variable, Segoe UI</FontFamily>
    <FontFamily x:Key="NfFontText">Segoe UI Variable Text, Segoe UI Variable, Segoe UI</FontFamily>
    <FontFamily x:Key="NfFontSmall">Segoe UI Variable Small, Segoe UI Variable, Segoe UI</FontFamily>

    <!-- ================================================================
         MICRO — l'indice, jamais le message.

         Compteur de pile, unités, annotations. Doit se lire comme une trace,
         et ne jamais entrer en concurrence avec le titre.
         ================================================================ -->
    <Style x:Key="NfMicroTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NfFontSmall}" />
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource NfTextTertiaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxLines" Value="1" />
    </Style>

    <!-- ================================================================
         LÉGENDE — la seconde ligne : artiste, sous-titre, source.
         ================================================================ -->
    <Style x:Key="NfCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NfFontSmall}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource NfTextSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxLines" Value="1" />
    </Style>

    <Style x:Key="NfCaptionStrongStyle" TargetType="TextBlock" BasedOn="{StaticResource NfCaptionTextStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource NfTextPrimaryBrush}" />
    </Style>

    <!-- ================================================================
         CORPS — le texte de la pilule au repos et des scènes.
         ================================================================ -->
    <Style x:Key="NfBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NfFontText}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="Foreground" Value="{ThemeResource NfTextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxLines" Value="1" />
    </Style>

    <Style x:Key="NfBodyStrongStyle" TargetType="TextBlock" BasedOn="{StaticResource NfBodyTextStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ================================================================
         TITRE — le titre d'une scène ouverte : morceau, notification.
         ================================================================ -->
    <Style x:Key="NfTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NfFontDisplay}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{ThemeResource NfTextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxLines" Value="1" />
    </Style>

    <!-- ================================================================
         NUMÉRIQUE — minuteur, pomodoro, horloge.

         NumeralAlignment="Tabular" est le point essentiel : sans lui, un
         chiffre « 1 » est plus étroit qu'un « 8 », et un compte à rebours fait
         tressauter sa propre largeur à chaque seconde. C'est le genre de détail
         qu'on ne remarque pas quand il est correct, et qu'on ne peut plus
         ignorer quand il ne l'est pas.
         ================================================================ -->
    <Style x:Key="NfNumericDisplayStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NfFontDisplay}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="30" />
        <Setter Property="Foreground" Value="{ThemeResource NfTextPrimaryBrush}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="MaxLines" Value="1" />
    </Style>

    <!-- Variante compacte : le même cadran, dans la pilule fermée. -->
    <Style x:Key="NfNumericCompactStyle" TargetType="TextBlock" BasedOn="{StaticResource NfNumericDisplayStyle}">
        <Setter Property="FontFamily" Value="{StaticResource NfFontText}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="LineHeight" Value="16" />
    </Style>

    <!-- ================================================================
         CARTE FERMÉE — les deux lignes du palier carte.

         Les deux styles sont déclarés côte à côte, et non en chaîne, parce que
         c'est leur rapport qui compte : la légende décrit la situation, le titre
         dit ce qui se passe. Si la légende montait d'un point de taille, ou si le
         titre descendait d'un point, les deux lignes se disputeraient la lecture
         et la carte n'aurait plus de sujet.

         Leurs hauteurs de ligne ne sont pas décoratives non plus : 14 pour la
         légende, 2 d'écart, 16 pour le titre — c'est exactement le contenu d'une
         carte de 52 DIP une fois les marges posées. Modifier l'une sans l'autre
         déformerait la forme, puisque la hauteur de la carte est la somme de son
         contenu. Voir ADR-012.
         ================================================================ -->
    <Style x:Key="NfCardSubheadStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NfFontSmall}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource NfTextSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxLines" Value="1" />
    </Style>

    <Style x:Key="NfCardHeadlineStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NfFontText}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="Foreground" Value="{ThemeResource NfTextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxLines" Value="1" />
    </Style>

    <!-- ================================================================
         LIBELLÉ DU PALIER SIGNAL — une seule ligne, à côté du glyphe.
         
         Même graisse que la légende de la carte mais en encre primaire : sur une
         ligne unique, il n'y a pas de hiérarchie à établir, seulement un nom à
         lire.
         ================================================================ -->
    <Style x:Key="NfSignalLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NfFontSmall}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource NfTextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxLines" Value="1" />
    </Style>

    <!-- ================================================================
         CORPS+ — la ligne qu'on lit en premier dans une scène ouverte quand
         le titre serait trop fort : un artiste, un expéditeur.
         ================================================================ -->
    <Style x:Key="NfBodyPlusTextStyle" TargetType="TextBlock" BasedOn="{StaticResource NfBodyTextStyle}">
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- ================================================================
         HÉROS — la valeur qui devient la matière principale d'une scène :
         65 pour le volume, 24:37 pour un minuteur. Toujours en chiffres à
         chasse fixe, pour que la valeur évolue sans que sa largeur danse.
         ================================================================ -->
    <Style x:Key="NfHeroTextStyle" TargetType="TextBlock" BasedOn="{StaticResource NfNumericDisplayStyle}">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="LineHeight" Value="32" />
    </Style>

</ResourceDictionary>
