<?xml version="1.0" encoding="utf-8"?>
<!--
    Jetons de conception SpaceNotch — la source unique du langage visuel.

    Règle : aucune valeur littérale de couleur, de rayon, d'espacement ou de
    durée ne doit apparaître ailleurs que dans ce fichier. Une teinte écrite en
    dur dans une scène est une dette : elle échappe au thème clair, au contraste
    élevé, et au réglage utilisateur.

    Les trois thèmes sont déclarés ensemble. Une clé absente d'un thème est une
    exception à l'exécution, pas un avertissement de compilation : elles sont
    donc toutes définies trois fois, délibérément.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <!-- ============================================================
             SOMBRE — le thème de référence du projet.
             ============================================================ -->
        <ResourceDictionary x:Key="Default">

            <!-- Surfaces : noir OLED pur, et **sans hiérarchie de surfaces**.

                 La recommandation générale du thème sombre dit l'inverse — « ne
                 jamais utiliser #000000 », parce que l'élévation se lit en
                 éclaircissant les surfaces. Elle vise les grandes surfaces de
                 navigation, où un fond pur noyerait les plans. Ici la surface
                 est un objet posé sur le bureau : le noir pur est ce qui la fait
                 disparaître dans l'écran, et c'est le but.

                 La hiérarchie n'est donc pas portée par un empilement de gris —
                 qui, sur une pastille de 28 de haut, ne se lirait que comme une
                 salissure — mais par des **traits** d'un pixel à peine visibles
                 et par la lumière du reflet. Voir ADR-016. -->
            <Color x:Key="NfSurfaceBaseColor">#000000</Color>
            <Color x:Key="NfSurfaceRaisedColor">#000000</Color>
            <Color x:Key="NfSurfaceSunkenColor">#000000</Color>

            <SolidColorBrush x:Key="NfSurfaceBaseBrush" Color="#000000" />
            <SolidColorBrush x:Key="NfSurfaceRaisedBrush" Color="#000000" />
            <SolidColorBrush x:Key="NfSurfaceSunkenBrush" Color="#000000" />

            <!-- Encre. Les opacités sont portées par le pinceau plutôt que par
                 UIElement.Opacity : un élément semi-transparent coûte une couche
                 de composition, un pinceau n'en coûte aucune. -->
            <!-- Encre plafonnée sous le blanc pur : sur un noir OLED, le blanc
                 absolu bave (halation). 92 % reste éclatant sans vibrer. -->
            <SolidColorBrush x:Key="NfTextPrimaryBrush" Color="#FFFFFF" Opacity="0.92" />
            <SolidColorBrush x:Key="NfTextSecondaryBrush" Color="#FFFFFF" Opacity="0.60" />
            <SolidColorBrush x:Key="NfTextTertiaryBrush" Color="#FFFFFF" Opacity="0.42" />

            <!-- Traits. Utilisés à l'intérieur de l'Island uniquement : jamais
                 sur son pourtour, qui doit rester sans arête. -->
            <SolidColorBrush x:Key="NfStrokeSubtleBrush" Color="#FFFFFF" Opacity="0.07" />
            <SolidColorBrush x:Key="NfStrokeStrongBrush" Color="#FFFFFF" Opacity="0.14" />

            <!-- Accent et états sémantiques. -->
            <Color x:Key="NfAccentColor">#4EA1FF</Color>
            <SolidColorBrush x:Key="NfAccentBrush" Color="#4EA1FF" />
            <SolidColorBrush x:Key="NfPositiveBrush" Color="#4ADE80" />
            <SolidColorBrush x:Key="NfWarningBrush" Color="#FBBF24" />
            <SolidColorBrush x:Key="NfCriticalBrush" Color="#F87171" />

            <!-- Teintes d'état.

                 Elles ne remplacent pas l'accent : l'accent dit « voici une
                 action », une teinte d'état dit « voici ce qui se passe ». Le
                 glyphe de tête de l'Island porte la seconde, jamais la première.

                 Aucune n'est jamais seule. La légende de la carte nomme toujours
                 l'état en mots, sans quoi l'information ne serait portée que par
                 la couleur — illisible en contraste élevé, pour une partie des
                 daltonismes, et pour quiconque ne distingue pas deux teintes
                 voisines. Voir ADR-014. -->
            <SolidColorBrush x:Key="NfStateNeutralBrush" Color="#FFFFFF" Opacity="0.72" />
            <SolidColorBrush x:Key="NfStateWorkingBrush" Color="#E8A66B" />
            <SolidColorBrush x:Key="NfStateInfoBrush" Color="#7FB3F0" />
            <SolidColorBrush x:Key="NfStateSuccessBrush" Color="#5FD08A" />
            <SolidColorBrush x:Key="NfStateAlertBrush" Color="#F0836B" />

            <!-- Reflet spéculaire : la lumière rasante du haut de la surface.

                 Ce n'est pas une décoration, c'est un jeton de séparation, et la
                 distinction est ce qui lui donne son opacité. Une ombre portée
                 disparaît sur un fond d'écran sombre — aucune ombre ne se
                 distingue d'une surface déjà noire —, si bien qu'un objet qui ne
                 compterait que sur elle s'effacerait selon le papier peint. Le
                 reflet est ce qui reste : il vient de la lumière, pas du fond.
                 Voir ADR-013. -->
            <LinearGradientBrush x:Key="NfSpecularBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="#FFFFFF" Offset="0.0" />
                <GradientStop Color="#00FFFFFF" Offset="1.0" />
            </LinearGradientBrush>
            <!-- Nul en sombre : sur une notch attachée au bord, un reflet en haut
                 se lirait comme un trait sur le bord de l'écran. Le noir OLED se
                 suffit ; la lumière vient de la matière et de l'atmosphère. -->
            <x:Double x:Key="NfSpecularOpacity">0.0</x:Double>

            <!-- Verre et élévation : pour les modes translucides et les surfaces
                 internes seulement. Le corps de la notch reste noir pur — c'est
                 ce qui la fond dans le bord de l'écran, et sur un écran OLED ce
                 qui la fait lire comme une découpe matérielle. #08090C est le
                 « noir relevé » du plan SpaceNotch 2.0 : il laisse la place à la
                 profondeur là où une surface doit se distinguer d'une autre. -->
            <Color x:Key="NfSurfaceGlassColor">#EB08090C</Color>
            <SolidColorBrush x:Key="NfSurfaceGlassBrush" Color="#08090C" Opacity="0.92" />
            <SolidColorBrush x:Key="NfSurfaceElevatedBrush" Color="#FFFFFF" Opacity="0.06" />

            <!-- Matière hypnotique : une lumière chaude, comme la référence
                 Inspora. Elle est teintée par l'état lorsqu'il en porte un. -->
            <Color x:Key="NfHypnoticWarmColor">#FFB46A</Color>

        </ResourceDictionary>

        <!-- ============================================================
             CLAIR — même grammaire, encre inversée.
             ============================================================ -->
        <ResourceDictionary x:Key="Light">

            <Color x:Key="NfSurfaceBaseColor">#F2F3F6</Color>
            <Color x:Key="NfSurfaceRaisedColor">#FFFFFF</Color>
            <Color x:Key="NfSurfaceSunkenColor">#E4E6EC</Color>

            <SolidColorBrush x:Key="NfSurfaceBaseBrush" Color="#F2F3F6" />
            <SolidColorBrush x:Key="NfSurfaceRaisedBrush" Color="#FFFFFF" Opacity="0.72" />
            <SolidColorBrush x:Key="NfSurfaceSunkenBrush" Color="#E4E6EC" Opacity="0.55" />

            <SolidColorBrush x:Key="NfTextPrimaryBrush" Color="#101014" Opacity="0.94" />
            <SolidColorBrush x:Key="NfTextSecondaryBrush" Color="#101014" Opacity="0.64" />
            <SolidColorBrush x:Key="NfTextTertiaryBrush" Color="#101014" Opacity="0.46" />

            <SolidColorBrush x:Key="NfStrokeSubtleBrush" Color="#101014" Opacity="0.08" />
            <SolidColorBrush x:Key="NfStrokeStrongBrush" Color="#101014" Opacity="0.16" />

            <Color x:Key="NfAccentColor">#0E6DD4</Color>
            <SolidColorBrush x:Key="NfAccentBrush" Color="#0E6DD4" />
            <SolidColorBrush x:Key="NfPositiveBrush" Color="#15803D" />
            <SolidColorBrush x:Key="NfWarningBrush" Color="#B45309" />
            <SolidColorBrush x:Key="NfCriticalBrush" Color="#B91C1C" />

            <!-- Même grammaire d'état, encre inversée : la teinte doit rester
                 lisible sur une surface claire, donc nettement plus sombre. -->
            <SolidColorBrush x:Key="NfStateNeutralBrush" Color="#101014" Opacity="0.72" />
            <SolidColorBrush x:Key="NfStateWorkingBrush" Color="#8A5217" />
            <SolidColorBrush x:Key="NfStateInfoBrush" Color="#1E5FA8" />
            <SolidColorBrush x:Key="NfStateSuccessBrush" Color="#15803D" />
            <SolidColorBrush x:Key="NfStateAlertBrush" Color="#B3402B" />

            <LinearGradientBrush x:Key="NfSpecularBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="#FFFFFF" Offset="0.0" />
                <GradientStop Color="#00FFFFFF" Offset="1.0" />
            </LinearGradientBrush>
            <x:Double x:Key="NfSpecularOpacity">0.35</x:Double>

            <Color x:Key="NfSurfaceGlassColor">#EBF2F3F6</Color>
            <SolidColorBrush x:Key="NfSurfaceGlassBrush" Color="#F2F3F6" Opacity="0.92" />
            <SolidColorBrush x:Key="NfSurfaceElevatedBrush" Color="#101014" Opacity="0.05" />

            <Color x:Key="NfHypnoticWarmColor">#D9822B</Color>

        </ResourceDictionary>

        <!-- ============================================================
             CONTRASTE ÉLEVÉ — l'atmosphère cède le pas à la lisibilité.
             Aucune translucidité, aucun reflet : les couleurs système priment.
             ============================================================ -->
        <ResourceDictionary x:Key="HighContrast">

            <Color x:Key="NfSurfaceBaseColor">#000000</Color>
            <Color x:Key="NfSurfaceRaisedColor">#000000</Color>
            <Color x:Key="NfSurfaceSunkenColor">#000000</Color>

            <SolidColorBrush x:Key="NfSurfaceBaseBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NfSurfaceRaisedBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NfSurfaceSunkenBrush" Color="{ThemeResource SystemColorWindowColor}" />

            <SolidColorBrush x:Key="NfTextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NfTextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NfTextTertiaryBrush" Color="{ThemeResource SystemColorGrayTextColor}" />

            <SolidColorBrush x:Key="NfStrokeSubtleBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NfStrokeStrongBrush" Color="{ThemeResource SystemColorWindowTextColor}" />

            <Color x:Key="NfAccentColor">#00FFFF</Color>
            <SolidColorBrush x:Key="NfAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NfPositiveBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NfWarningBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NfCriticalBrush" Color="{ThemeResource SystemColorHotlightColor}" />

            <!-- En contraste élevé, la distinction entre états ne peut pas reposer
                 sur des teintes choisies : elle repose sur les couleurs du système,
                 et c'est la légende qui porte le sens. -->
            <SolidColorBrush x:Key="NfStateNeutralBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NfStateWorkingBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NfStateInfoBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NfStateSuccessBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NfStateAlertBrush" Color="{ThemeResource SystemColorHotlightColor}" />

            <LinearGradientBrush x:Key="NfSpecularBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="#00FFFFFF" Offset="0.0" />
                <GradientStop Color="#00FFFFFF" Offset="1.0" />
            </LinearGradientBrush>
            <x:Double x:Key="NfSpecularOpacity">0.0</x:Double>

            <Color x:Key="NfSurfaceGlassColor">#FF000000</Color>
            <SolidColorBrush x:Key="NfSurfaceGlassBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NfSurfaceElevatedBrush" Color="{ThemeResource SystemColorWindowColor}" />

            <Color x:Key="NfHypnoticWarmColor">#FFFFFF</Color>

        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- ================================================================
         GÉOMÉTRIE — invariante par thème.

         Le rayon des congés de la notch elle-même reste gouverné par
         AppSettings, parce qu'il se règle : 26 en compact, 34 ouverte,
         interpolé selon la hauteur (NotchGeometry). Les épaules concaves qui la
         raccordent au bord de l'écran valent 8. Les jetons ci-dessous servent
         aux surfaces internes.

         RÈGLE DE CONCENTRICITÉ. Un rayon intérieur ne peut pas être supérieur au
         rayon de son conteneur : une surface nichée dans un congé de 26 ne peut
         pas afficher un congé de 28, la courbe extérieure passerait alors à
         l'intérieur de l'intérieure et les deux se croiseraient visiblement. La
         formule usuelle — rayon intérieur = rayon extérieur − marge — a été
         appliquée aux valeurs ci-dessous, et la règle est vérifiée par un test :
         aucun jeton intérieur n'atteint le rayon du conteneur. Voir ADR-012.
         ================================================================ -->
    <x:Double x:Key="NfRadiusChip">6</x:Double>
    <x:Double x:Key="NfRadiusControl">8</x:Double>
    <x:Double x:Key="NfRadiusInner">10</x:Double>

    <CornerRadius x:Key="NfCornerChip">6</CornerRadius>
    <CornerRadius x:Key="NfCornerControl">8</CornerRadius>
    <CornerRadius x:Key="NfCornerInner">10</CornerRadius>

    <!-- Petite pochette dans la forme compacte : un carré à peine arrondi,
         qui se lit comme une image et non comme une pastille. -->
    <CornerRadius x:Key="NfCornerArtworkSmall">4</CornerRadius>

    <!-- Matière hypnotique de la cible de dépôt. -->
    <x:Double x:Key="NfHypnoticDropSize">28</x:Double>

    <!-- Palier veille : un point, rien de plus. -->
    <x:Double x:Key="NfIdleDotSize">6</x:Double>

    <!-- Palier signal : un glyphe et un libellé court, sur une ligne. -->
    <x:Double x:Key="NfSignalGlyphSize">14</x:Double>
    <Thickness x:Key="NfSignalPadding">12,0,12,2</Thickness>

    <!-- Contrôles d'une carte : pilules au trait, jamais de surface remplie.
         C'est la conséquence directe du « sans hiérarchie » ci-dessus : un
         contrôle se distingue par son contour et par son encre, pas par un fond
         plus clair — sinon la carte redevient un empilement de gris. -->
    <x:Double x:Key="NfActionHeight">30</x:Double>
    <x:Double x:Key="NfActionFontSize">11.5</x:Double>
    <Thickness x:Key="NfActionPadding">12,0,12,0</Thickness>

    <!-- Palier carte : glyphe, légende et titre, sur deux lignes. -->
    <x:Double x:Key="NfCardGlyphSize">20</x:Double>
    <x:Double x:Key="NfCardLineGap">2</x:Double>
    <Thickness x:Key="NfCardPadding">14,10,14,10</Thickness>


    <!-- Échelle d'espacement. Une seule progression, pas de valeur hors barème. -->
    <x:Double x:Key="NfSpace2">2</x:Double>
    <x:Double x:Key="NfSpace4">4</x:Double>
    <x:Double x:Key="NfSpace6">6</x:Double>
    <x:Double x:Key="NfSpace8">8</x:Double>
    <x:Double x:Key="NfSpace12">12</x:Double>
    <x:Double x:Key="NfSpace16">16</x:Double>
    <x:Double x:Key="NfSpace20">20</x:Double>
    <x:Double x:Key="NfSpace24">24</x:Double>

    <Thickness x:Key="NfPillPadding">12,0,12,4</Thickness>
    <Thickness x:Key="NfScenePadding">16,10,16,14</Thickness>

    <!-- Hauteur du reflet spéculaire, en DIPs. Bornée à la forme : sur un palier
         de 28 de haut, une bande de 22 mordrait dans les congés et le reflet
         dessinerait lui-même une arête. -->
    <x:Double x:Key="NfSpecularHeight">22</x:Double>

    <!-- Ombre portée, portée par le compositeur dans la fenêtre décorative.
         Deux jeux : au repos l'objet est proche de l'écran, déployé il s'en
         détache, et l'ombre doit suivre ce raisonnement pour que la profondeur
         reste cohérente. Voir ADR-013. -->
    <x:Double x:Key="NfShadowOffsetY">8</x:Double>
    <x:Double x:Key="NfShadowBlurRadius">24</x:Double>
    <x:Double x:Key="NfShadowOpacity">0.30</x:Double>
    <x:Double x:Key="NfShadowDeployedOffsetY">10</x:Double>
    <x:Double x:Key="NfShadowDeployedBlurRadius">30</x:Double>
    <x:Double x:Key="NfShadowDeployedOpacity">0.34</x:Double>

    <!-- Aura colorée autour du glyphe de tête. Elle reprend la teinte de l'état,
         jamais une couleur propre : c'est ce qui fait qu'un même halo dit
         « travail en cours » en ambre et « alerte » en rouge, sans que la forme
         change. -->
    <x:Double x:Key="NfGlowOpacity">0.35</x:Double>

    <!-- ================================================================
         MOUVEMENT

         Les ressorts sont déclarés ici pour que le langage de mouvement soit
         lisible au même endroit que le langage visuel. Le ressort de la forme
         de l'Island reste réglable par l'utilisateur ; ceux-ci gouvernent les
         transitions internes, qui ne se règlent pas.
         ================================================================ -->
    <x:Double x:Key="NfSpringContentStiffness">320</x:Double>
    <x:Double x:Key="NfSpringContentDamping">26</x:Double>
    <x:Double x:Key="NfSpringContentMass">1</x:Double>

    <!-- Durées de fondu, en millisecondes. Volontairement courtes : le contenu
         doit avoir fini d'apparaître avant que la forme ait fini de bouger. -->
    <x:Double x:Key="NfDurationInstant">90</x:Double>
    <x:Double x:Key="NfDurationQuick">140</x:Double>
    <x:Double x:Key="NfDurationCalm">220</x:Double>
    <x:Double x:Key="NfDurationSlow">420</x:Double>

    <!-- Échelle de départ d'une scène entrante. En dessous de 1, elle semble
         venir du fond : l'Island pousse son contenu vers l'utilisateur. -->
    <x:Double x:Key="NfSceneEnterScale">0.965</x:Double>
    <x:Double x:Key="NfSceneExitScale">0.985</x:Double>

</ResourceDictionary>
