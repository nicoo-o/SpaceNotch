<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SpaceNotch_App.Views.Scenes.LauncherScene"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Recherche façon Spotlight / Raycast. Les hauteurs suivent LauncherLayout
        (cœur) : barre 52, filet 1, liste (en-têtes 26, lignes 40, calcul 70),
        pied 40, marge basse 10. La notch prend exactement cette hauteur.
    -->
    <Grid x:Name="RootGrid" Padding="0,0,0,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <!-- Barre : loupe, champ en 17 px, pastille Échap. -->
        <Grid Grid.Row="0" Padding="20,0,14,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <FontIcon
                Grid.Column="0"
                Glyph="&#xE721;"
                FontSize="16"
                Foreground="{ThemeResource NfTextTertiaryBrush}"
                VerticalAlignment="Center" />

            <TextBox
                x:Name="SearchBox"
                Grid.Column="1"
                Style="{StaticResource NfSearchFieldStyle}"
                PlaceholderText="Rechercher des applications, réglages, fichiers…"
                AutomationProperties.Name="Rechercher"
                TextChanged="OnSearchTextChanged"
                GotFocus="OnSearchGotFocus"
                LostFocus="OnSearchLostFocus"
                PreviewKeyDown="OnSearchPreviewKeyDown" />

            <Border
                x:Name="EscapeChip"
                Grid.Column="2"
                Style="{StaticResource NfKeyCapStyle}"
                VerticalAlignment="Center">
                <TextBlock Text="Échap" Style="{StaticResource NfKeyCapTextStyle}" />
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="{ThemeResource NfStrokeSubtleBrush}" />

        <!-- Liste : pilule de sélection sous les lignes, qui glisse de l'une à l'autre. -->
        <ScrollViewer
            x:Name="ListScroller"
            Grid.Row="2"
            Padding="8,6,8,0"
            HorizontalScrollMode="Disabled"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid x:Name="ListHost">
                <Border
                    x:Name="SelectionPill"
                    Height="40"
                    VerticalAlignment="Top"
                    CornerRadius="10"
                    Background="{ThemeResource NfSelectionBrush}"
                    IsHitTestVisible="False"
                    Opacity="0" />
                <StackPanel x:Name="RowsPanel" />
            </Grid>
        </ScrollViewer>

        <!-- État vide ou chargement : une ligne d'aide, pas un écran blanc. -->
        <StackPanel
            x:Name="EmptyState"
            Grid.Row="2"
            Padding="24,14,24,0"
            Spacing="2"
            Visibility="Collapsed">
            <TextBlock
                x:Name="EmptyTitle"
                FontSize="13"
                Foreground="{ThemeResource NfTextSecondaryBrush}"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- Pied : rappels clavier, raccourci global à droite. -->
        <Grid
            Grid.Row="3"
            Padding="20,0,16,0"
            BorderBrush="{ThemeResource NfStrokeSubtleBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel x:Name="FooterHints" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center" />
            <TextBlock
                x:Name="HotkeyText"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FontSize="11.5"
                Foreground="{ThemeResource NfTextTertiaryBrush}" />
        </Grid>

        <!-- Panneau d'actions (Ctrl+K ou clic droit) : flotte en bas à droite. -->
        <Border
            x:Name="ActionsPanel"
            Grid.Row="0"
            Grid.RowSpan="4"
            Width="300"
            Margin="0,0,12,6"
            Padding="6"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="{ThemeResource NfPopupBrush}"
            BorderBrush="{ThemeResource NfControlStrokeBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Visibility="Collapsed">
            <StackPanel Spacing="2">
                <TextBlock
                    x:Name="ActionsTitle"
                    Margin="10,6,10,4"
                    FontSize="11.5"
                    Foreground="{ThemeResource NfTextTertiaryBrush}"
                    TextTrimming="CharacterEllipsis" />
                <Grid>
                    <Border
                        x:Name="ActionPill"
                        Height="36"
                        VerticalAlignment="Top"
                        CornerRadius="8"
                        Background="{ThemeResource NfSelectionBrush}"
                        IsHitTestVisible="False" />
                    <StackPanel x:Name="ActionRows" />
                </Grid>
                <Border Height="1" Margin="4,4" Background="{ThemeResource NfStrokeSubtleBrush}" />
                <TextBox
                    x:Name="ActionsFilter"
                    Style="{StaticResource NfSearchFieldStyle}"
                    FontSize="12.5"
                    Margin="6,0,6,2"
                    PlaceholderText="Filtrer les actions…"
                    AutomationProperties.Name="Filtrer les actions"
                    TextChanged="OnActionsFilterChanged"
                    PreviewKeyDown="OnActionsPreviewKeyDown" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
