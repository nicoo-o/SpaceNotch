<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SpaceNotch_App.Views.Scenes.LauncherScene"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="14,10,14,12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            Le champ de recherche transmet la saisie à la fonctionnalité, qui
            filtre et republie. La vue ne filtre jamais elle-même : le jeu
            d'applications reste une donnée de la fonctionnalité.
        -->
        <AutoSuggestBox
            x:Name="SearchBox"
            Grid.Row="0"
            PlaceholderText="Rechercher une application…"
            QueryIcon="Find"
            FontSize="12"
            TextChanged="OnSearchTextChanged" />

        <GridView
            x:Name="AppsGridView"
            Grid.Row="1"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="OnAppInvoked">
            <GridView.ItemTemplate>
                <DataTemplate>
                    <Grid Width="96" Height="62" Padding="8,6,8,6" RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--
                            La marque de favori est un texte, pas un booléen : cela
                            évite un convertisseur de visibilité dans le rendu, pour
                            un résultat identique.
                        -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xECAA;" FontSize="14" Foreground="#FFFFFF" />
                            <TextBlock
                                Text="{Binding FavoriteMark}"
                                FontSize="9"
                                Foreground="#4EA1FF"
                                VerticalAlignment="Top" />
                        </StackPanel>

                        <TextBlock
                            Grid.Row="1"
                            Text="{Binding Name}"
                            FontSize="10"
                            Foreground="#CCFFFFFF"
                            TextTrimming="CharacterEllipsis"
                            MaxLines="1"
                            HorizontalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <TextBlock
            x:Name="EmptyText"
            Grid.Row="1"
            Text="Aucune application trouvée"
            FontSize="11"
            Foreground="#60FFFFFF"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
