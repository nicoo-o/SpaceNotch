<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SpaceNotch_App.Views.Scenes.LauncherScene"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Surface de commande, pas un menu Démarrer : un champ, puis une liste
        courte qui se parcourt au clavier. Entrée lance le premier résultat.
    -->
    <Grid Padding="14,8,14,12" RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            Le champ de recherche transmet la saisie à la fonctionnalité, qui
            filtre et republie. La vue ne filtre jamais elle-même : le jeu
            d'applications reste une donnée de la fonctionnalité.
        -->
        <AutoSuggestBox
            x:Name="SearchBox"
            Grid.Row="0"
            PlaceholderText="Rechercher…"
            QueryIcon="Find"
            FontSize="12"
            AutomationProperties.Name="Rechercher une application"
            TextChanged="OnSearchTextChanged"
            QuerySubmitted="OnQuerySubmitted" />

        <TextBlock
            x:Name="SectionText"
            Grid.Row="1"
            Text="Récents"
            Style="{StaticResource NfCaptionTextStyle}"
            Foreground="{ThemeResource NfTextTertiaryBrush}"
            Margin="4,2,0,0" />

        <ListView
            x:Name="AppsList"
            Grid.Row="2"
            SelectionMode="Single"
            IsItemClickEnabled="True"
            ItemClick="OnAppInvoked"
            KeyDown="OnListKeyDown">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Height="30" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Grid.Column="0"
                            Glyph="&#xECAA;"
                            FontSize="13"
                            Foreground="{ThemeResource NfTextSecondaryBrush}"
                            VerticalAlignment="Center" />

                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding Name}"
                            Style="{StaticResource NfBodyTextStyle}"
                            VerticalAlignment="Center" />

                        <!--
                            La marque de récent est un texte, pas un booléen : cela
                            évite un convertisseur de visibilité dans le rendu.
                        -->
                        <TextBlock
                            Grid.Column="2"
                            Text="{Binding FavoriteMark}"
                            Style="{StaticResource NfMicroTextStyle}"
                            VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            x:Name="EmptyText"
            Grid.Row="2"
            Text="Aucune application trouvée"
            Style="{StaticResource NfCaptionTextStyle}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
