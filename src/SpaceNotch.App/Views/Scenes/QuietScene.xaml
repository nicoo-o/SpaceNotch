<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SpaceNotch_App.Views.Scenes.QuietScene"
    xmlns:l="using:SpaceNotch_App.Views"
    xmlns:views="using:SpaceNotch_App.Views"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Ne pas déranger (F9) : la lune, puis ce qui est arrivé, groupé par application. -->
    <Grid Padding="{StaticResource NfScenePadding}" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <views:GlyphView Key="Moon" Size="16" VerticalAlignment="Center" Tint="{ThemeResource NfTextPrimaryBrush}" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource NfTextPrimaryBrush}" />
                <TextBlock x:Name="SubtitleText" FontSize="11.5" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource NfTextSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <StackPanel x:Name="Groups" Grid.Row="1" Spacing="4" />
    </Grid>
</UserControl>
