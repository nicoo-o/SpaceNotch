<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SpaceNotch_App.Views.Scenes.NotificationScene"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Groupe de notifications ouvert : l'application et le nombre, le message
        le plus récent, puis les précédents en une ligne chacun.

        Ce n'est pas une carte Windows : aucune surface dans la surface, aucune
        couleur d'accent — l'encre et la hiérarchie typographique suffisent.
    -->
    <Grid Padding="16,8,14,12" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <FontIcon
            x:Name="AppIcon"
            Grid.Column="0"
            Glyph="&#xEA8F;"
            FontSize="18"
            Foreground="{ThemeResource NfStateInfoBrush}"
            VerticalAlignment="Top"
            Margin="0,3,0,0" />

        <StackPanel Grid.Column="1" Spacing="2">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock
                    x:Name="AppSourceText"
                    Text="Application"
                    Style="{StaticResource NfCaptionTextStyle}"
                    Foreground="{ThemeResource NfTextTertiaryBrush}" />
                <TextBlock
                    x:Name="CountText"
                    Style="{StaticResource NfMetricTextStyle}"
                    Visibility="Collapsed" />
            </StackPanel>

            <TextBlock
                x:Name="TitleText"
                Text="Titre de la notification"
                Style="{StaticResource NfCardHeadlineStyle}" />

            <TextBlock
                x:Name="BodyText"
                Text="Message…"
                Style="{StaticResource NfCaptionTextStyle}"
                MaxLines="2"
                TextWrapping="WrapWholeWords" />

            <!-- Les messages précédents du groupe : une ligne chacun. -->
            <StackPanel x:Name="HistoryHost" Spacing="2" Margin="0,4,0,0" />
        </StackPanel>

        <Button
            Style="{StaticResource NfIconButtonStyle}"
            x:Name="CloseButton"
            Grid.Column="2"
            Width="26"
            Height="26"
            CornerRadius="13"
            Padding="0"
            Background="{ThemeResource NfSurfaceElevatedBrush}"
            BorderThickness="0"
            VerticalAlignment="Top"
            ToolTipService.ToolTip="Fermer"
            AutomationProperties.Name="Fermer la notification"
            Click="OnCloseClicked">
            <FontIcon Glyph="&#xE8BB;" FontSize="9" Foreground="{ThemeResource NfTextSecondaryBrush}" />
        </Button>
    </Grid>
</UserControl>
