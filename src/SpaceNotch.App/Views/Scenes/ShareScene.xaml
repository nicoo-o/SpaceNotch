<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SpaceNotch_App.Views.Scenes.ShareScene"
    xmlns:l="using:SpaceNotch_App.Views"
    xmlns:views="using:SpaceNotch_App.Views"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Partage PC → téléphone (F8) : le QR code à gauche, le fichier et l'expiration à droite. -->
    <Grid Padding="{StaticResource NfScenePadding}" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Un carré clair : un téléphone lit mieux des modules sombres sur fond clair. -->
        <Border
            x:Name="QrCard"
            Width="136"
            Height="136"
            Padding="8"
            CornerRadius="10"
            Background="#FFF4F6FA">
            <Path x:Name="QrModules" Fill="#FF0B0C10" Stretch="None" />
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <views:GlyphView Key="Qr" Size="14" VerticalAlignment="Center" Tint="{ThemeResource NfTextSecondaryBrush}" />
                <TextBlock x:Name="HintText" FontSize="11.5" VerticalAlignment="Center" Foreground="{ThemeResource NfTextSecondaryBrush}" />
            </StackPanel>
            <TextBlock x:Name="FileText" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource NfTextPrimaryBrush}" />
            <TextBlock x:Name="ExpiryText" FontSize="11.5" TextWrapping="Wrap" Foreground="{ThemeResource NfTextTertiaryBrush}" />
            <Button
                x:Name="StopButton"
                Margin="0,6,0,0"
                Height="28"
                MinHeight="0"
                Padding="12,0"
                CornerRadius="14"
                Style="{StaticResource NfSecondaryButtonStyle}"
                Click="OnStopClicked" />
        </StackPanel>
    </Grid>
</UserControl>
