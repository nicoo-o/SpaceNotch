<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SpaceNotch_App.Views.Scenes.WelcomeScene"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Présentation du premier lancement : 440 × 236. Illustration de 96 DIP,
        titre 16, deux lignes 12,5, pied (points, Passer, Suivant). Voir
        w3-bienvenue (visuel validé).
    -->
    <Grid x:Name="RootGrid" Padding="{StaticResource NfScenePadding}" KeyDown="OnKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="96" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            x:Name="IllustrationFrame"
            Grid.Row="0"
            CornerRadius="12"
            Background="#FF0B0C0F"
            BorderBrush="{ThemeResource NfStrokeSubtleBrush}"
            BorderThickness="1">
            <Canvas x:Name="Illustration" />
        </Border>

        <StackPanel x:Name="TextBlockHost" Grid.Row="1" Margin="0,12,0,0" Spacing="3">
            <TextBlock
                x:Name="TitleText"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="{ThemeResource NfTextPrimaryBrush}" />
            <TextBlock
                x:Name="DescriptionText"
                FontSize="12.5"
                LineHeight="17"
                TextWrapping="Wrap"
                MaxLines="2"
                TextTrimming="CharacterEllipsis"
                Foreground="{ThemeResource NfTextSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="Dots" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" />

            <Button
                x:Name="SecondaryButton"
                Grid.Column="1"
                Style="{StaticResource NfGhostButtonStyle}"
                MinHeight="28"
                Padding="12,4"
                Click="OnSecondaryClicked" />

            <Button
                x:Name="PrimaryButton"
                Grid.Column="2"
                Style="{StaticResource NfPrimaryButtonStyle}"
                MinHeight="28"
                Padding="14,4"
                Click="OnPrimaryClicked" />
        </Grid>
    </Grid>
</UserControl>
