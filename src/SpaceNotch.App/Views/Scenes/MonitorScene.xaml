<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SpaceNotch_App.Views.Scenes.MonitorScene"
    xmlns:l="using:SpaceNotch_App.Views"
    xmlns:views="using:SpaceNotch_App.Views"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Moniteur système (F6) : le processus gourmand, la courbe du processeur, la fermeture. -->
    <Grid Padding="{StaticResource NfScenePadding}" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <views:GlyphView x:Name="CpuGlyph" Key="Cpu" Size="16" VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="ProcessText" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource NfTextPrimaryBrush}" />
                <TextBlock x:Name="LoadText" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource NfTextSecondaryBrush}" />
            </StackPanel>

            <Button
                x:Name="CloseProcess"
                Grid.Column="2"
                Height="28"
                MinHeight="0"
                Padding="12,0"
                VerticalAlignment="Center"
                CornerRadius="14"
                Style="{StaticResource NfGhostButtonStyle}"
                Click="OnCloseClicked" />
        </Grid>

        <!-- La courbe : les trente dernières mesures, de gauche (anciennes) à droite. -->
        <Grid x:Name="CurveHost" Grid.Row="1" Height="36" VerticalAlignment="Bottom">
            <Path x:Name="CurveFill" Opacity="0.16" />
            <Path x:Name="CurveLine" StrokeThickness="1.5" StrokeLineJoin="Round" />
            <Rectangle x:Name="ThresholdLine" Height="1" VerticalAlignment="Top" Opacity="0.25" />
        </Grid>
    </Grid>
</UserControl>
