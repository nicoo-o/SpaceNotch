<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SpaceNotch_App.Views.Scenes.InfoScene"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:SpaceNotch_App.Views"
    mc:Ignorable="d">

    <!--
        Scène générique : utilisée pour toute clé de scène qui n'a pas encore de
        vue dédiée (Bluetooth, et la carte destinée aux greffons). Elle évite
        qu'une fonctionnalité nouvelle doive modifier la fenêtre pour s'afficher.

        Elle rend les actions que la fonctionnalité déclare. Sans cela, un greffon
        tiers n'aurait aucun moyen d'exposer un contrôle : l'API lui permettrait de
        déclarer une action que personne n'afficherait.
    -->
    <StackPanel x:Name="SceneRoot" Padding="{StaticResource NfScenePadding}" Spacing="8" Background="Transparent" PointerPressed="OnScenePointerPressed">

        <Grid x:Name="HeaderGrid" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Disposition en ligne (vague 6) : ce qui suit le texte, à droite —
                 une étiquette de couleur, les avatars d'un salon, les contrôles. -->
            <StackPanel
                x:Name="TrailHost"
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <Border x:Name="TrailBadge" CornerRadius="999" Padding="9,3" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="TrailBadgeText" FontSize="11.5" FontWeight="SemiBold" />
                </Border>
                <!-- Carte d'agent : un appui la développe sur ses dernières actions. -->
                <TextBlock
                    x:Name="DetailsHint"
                    Text="&#x25BE;"
                    FontSize="12"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource NfTextTertiaryBrush}"
                    Visibility="Collapsed" />
            </StackPanel>

            <!-- Pastille d'icône : contour au trait, jamais de fond rempli.
                 Un fond légèrement plus clair serait une seconde surface, donc
                 une hiérarchie — et sur un objet de 38 DIP de côté, elle ne se
                 lit pas comme un plan mais comme une tache. -->
            <!-- La pastille porte, dans l'ordre de préférence : la grille
                 hypnotique d'un travail en cours, l'image de l'activité, son
                 glyphe. Elle est aussi le point d'arrivée du morphing depuis la
                 forme compacte. -->
            <Border
                x:Name="IconBadge"
                Grid.Column="0"
                Width="38"
                Height="38"
                CornerRadius="{StaticResource NfCornerInner}"
                Background="Transparent"
                BorderBrush="{ThemeResource NfStrokeStrongBrush}"
                BorderThickness="1"
                VerticalAlignment="Center">
                <Grid>
                    <views:GlyphView
                        x:Name="SceneIcon"
                        Size="16"
                        FallbackKey="Info"
                        Tint="{ThemeResource NfTextPrimaryBrush}" />

                    <Image
                        x:Name="SceneArtwork"
                        Stretch="UniformToFill"
                        Visibility="Collapsed" />

                    <Grid
                        x:Name="SceneHypnoticHost"
                        Width="20"
                        Height="20"
                        IsHitTestVisible="False"
                        Visibility="Collapsed" />

                    <!-- Pixel, avatar des agents (ADR-029), dans la pastille ouverte. -->
                    <views:PixelAvatarView
                        x:Name="SceneAvatar"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                <!-- Contexte discret au-dessus de l'état, comme dans la
                     référence : « Read app-sidebar.tsx · 219 lines ». -->
                <TextBlock
                    x:Name="EyebrowText"
                    Style="{StaticResource NfCaptionTextStyle}"
                    Foreground="{ThemeResource NfTextTertiaryBrush}"
                    Visibility="Collapsed" />

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="TitleText"
                    Text="Information"
                    FontSize="13.5"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource NfTextPrimaryBrush}"
                    TextTrimming="CharacterEllipsis"
                    MaxLines="1" />

                    <TextBlock
                        x:Name="MetricText"
                        Grid.Column="1"
                        Style="{StaticResource NfMetricTextStyle}"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />
                </Grid>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Étiquette devant le sous-titre : « Copié · anglais → français ». -->
                    <Border x:Name="InlineBadge" CornerRadius="999" Padding="9,2" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="InlineBadgeText" FontSize="11.5" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock
                    x:Name="SubtitleText"
                    Grid.Column="1"
                    Text=""
                    FontSize="11.5"
                    Foreground="{ThemeResource NfTextSecondaryBrush}"
                    TextTrimming="CharacterEllipsis"
                    MaxLines="2" />
                </Grid>

                <!-- Progression : un fil, pas une barre de logiciel. Le
                     remplissage est une échelle, jamais une largeur recalculée. -->
                <Grid
                    x:Name="ProgressTrack"
                    Height="3"
                    Margin="0,4,0,0"
                    CornerRadius="1.5"
                    Background="{ThemeResource NfStrokeSubtleBrush}"
                    Visibility="Collapsed">
                    <Border
                        x:Name="ProgressFill"
                        CornerRadius="1.5"
                        Background="{ThemeResource NfTextPrimaryBrush}"
                        RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="ProgressScale" ScaleX="0" />
                        </Border.RenderTransform>
                    </Border>
                </Grid>

                <!-- Barre à étapes (W1) : un segment par étape, rempli à son tour. -->
                <Grid
                    x:Name="StepsTrack"
                    Height="3"
                    Margin="0,4,0,0"
                    ColumnSpacing="3"
                    Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <!-- Dernières actions d'un agent (carte développée) : une puce teintée et la ligne. -->
        <StackPanel x:Name="RecentList" Spacing="4" Margin="50,0,0,0" Visibility="Collapsed" />

        <!-- Livraison (T2) : trois étapes sur un fil, le véhicule en pixels qui avance. -->
        <Grid x:Name="DeliveryTrack" Height="16" Margin="2,0,2,0" Visibility="Collapsed" SizeChanged="OnDeliveryTrackSizeChanged">
            <Border Height="2" VerticalAlignment="Center" CornerRadius="1" Background="#22FFFFFF" />
            <Border x:Name="DeliveryDone" Height="2" VerticalAlignment="Center" HorizontalAlignment="Left" CornerRadius="1" Width="0" Background="{ThemeResource NfTextPrimaryBrush}" />
            <Canvas x:Name="DeliveryCanvas" IsHitTestVisible="False" />
        </Grid>

        <!-- Salle vocale (T3) : une identicône par personne, allumée quand elle parle. -->
        <StackPanel x:Name="VoiceRow" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Visibility="Collapsed" />


        <!--
            Rangée de contrôles, construite à partir des actions déclarées. Elle
            reste masquée tant qu'aucune action n'est annoncée : une carte sans
            contrôle ne doit pas réserver d'espace vide.
        -->
        <StackPanel
            x:Name="ActionHost"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Spacing="10"
            Visibility="Collapsed" />

        <!-- Miroir (W5) : la webcam au survol de « Rejoindre » et l’état du micro, sous les contrôles pour que le bouton ne bouge pas sous le pointeur. -->
        <StackPanel x:Name="MirrorPanel" Orientation="Horizontal" Spacing="18" HorizontalAlignment="Center" Visibility="Collapsed">
            <!-- Un petit miroir rond, comme dans la maquette. -->
            <Border Width="92" Height="92" CornerRadius="46" Background="#FF1D2230" BorderBrush="{ThemeResource NfStrokeSubtleBrush}" BorderThickness="1">
                <MediaPlayerElement x:Name="MirrorVideo" Stretch="UniformToFill" AreTransportControlsEnabled="False" IsHitTestVisible="False">
                    <MediaPlayerElement.RenderTransform>
                        <ScaleTransform ScaleX="-1" CenterX="46" />
                    </MediaPlayerElement.RenderTransform>
                </MediaPlayerElement>
            </Border>
            <StackPanel Spacing="8" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <views:GlyphView x:Name="MirrorMicGlyph" Key="Microphone" Size="14" />
                    <TextBlock x:Name="MirrorMic" FontSize="11.5" Foreground="{ThemeResource NfTextSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <views:GlyphView x:Name="MirrorCamGlyph" Key="Camera" Size="14" />
                    <TextBlock x:Name="MirrorCam" FontSize="11.5" Foreground="{ThemeResource NfTextSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>