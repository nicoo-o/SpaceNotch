<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SpaceNotch_App.Views.Scenes.InfoScene"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:SpaceNotch_App.Views"
    mc:Ignorable="d">

    <!--
        Scène générique : utilisée pour toute clé de scène qui n'a pas encore de
        vue dédiée (Bluetooth, et la carte destinée aux greffons). Elle évite
        qu'une fonctionnalité nouvelle doive modifier la fenêtre pour s'afficher.

        Elle rend les actions que la fonctionnalité déclare. Sans cela, un greffon
        tiers n'aurait aucun moyen d'exposer un contrôle : l'API lui permettrait de
        déclarer une action que personne n'afficherait.
    -->
    <StackPanel Padding="{StaticResource NfScenePadding}" Spacing="8">

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Pastille d'icône : contour au trait, jamais de fond rempli.
                 Un fond légèrement plus clair serait une seconde surface, donc
                 une hiérarchie — et sur un objet de 38 DIP de côté, elle ne se
                 lit pas comme un plan mais comme une tache. -->
            <!-- La pastille porte, dans l'ordre de préférence : la grille
                 hypnotique d'un travail en cours, l'image de l'activité, son
                 glyphe. Elle est aussi le point d'arrivée du morphing depuis la
                 forme compacte. -->
            <Border
                x:Name="IconBadge"
                Grid.Column="0"
                Width="38"
                Height="38"
                CornerRadius="{StaticResource NfCornerInner}"
                Background="Transparent"
                BorderBrush="{ThemeResource NfStrokeStrongBrush}"
                BorderThickness="1"
                VerticalAlignment="Center">
                <Grid>
                    <views:GlyphView
                        x:Name="SceneIcon"
                        Size="16"
                        FallbackKey="Info"
                        Tint="{ThemeResource NfTextPrimaryBrush}" />

                    <Image
                        x:Name="SceneArtwork"
                        Stretch="UniformToFill"
                        Visibility="Collapsed" />

                    <Grid
                        x:Name="SceneHypnoticHost"
                        Width="20"
                        Height="20"
                        IsHitTestVisible="False"
                        Visibility="Collapsed" />

                    <!-- Clawd (I4) : la mascotte de Claude Code dans la pastille ouverte. -->
                    <views:ClawdView
                        x:Name="SceneClawd"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                <!-- Contexte discret au-dessus de l'état, comme dans la
                     référence : « Read app-sidebar.tsx · 219 lines ». -->
                <TextBlock
                    x:Name="EyebrowText"
                    Style="{StaticResource NfCaptionTextStyle}"
                    Foreground="{ThemeResource NfTextTertiaryBrush}"
                    Visibility="Collapsed" />

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="TitleText"
                    Text="Information"
                    FontSize="13.5"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource NfTextPrimaryBrush}"
                    TextTrimming="CharacterEllipsis"
                    MaxLines="1" />

                    <TextBlock
                        x:Name="MetricText"
                        Grid.Column="1"
                        Style="{StaticResource NfMetricTextStyle}"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />
                </Grid>

                <TextBlock
                    x:Name="SubtitleText"
                    Text=""
                    FontSize="11.5"
                    Foreground="{ThemeResource NfTextSecondaryBrush}"
                    TextTrimming="CharacterEllipsis"
                    MaxLines="2" />

                <!-- Progression : un fil, pas une barre de logiciel. Le
                     remplissage est une échelle, jamais une largeur recalculée. -->
                <Grid
                    x:Name="ProgressTrack"
                    Height="3"
                    Margin="0,4,0,0"
                    CornerRadius="1.5"
                    Background="{ThemeResource NfStrokeSubtleBrush}"
                    Visibility="Collapsed">
                    <Border
                        x:Name="ProgressFill"
                        CornerRadius="1.5"
                        Background="{ThemeResource NfTextPrimaryBrush}"
                        RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="ProgressScale" ScaleX="0" />
                        </Border.RenderTransform>
                    </Border>
                </Grid>

                <!-- Barre à étapes (W1) : un segment par étape, rempli à son tour. -->
                <Grid
                    x:Name="StepsTrack"
                    Height="3"
                    Margin="0,4,0,0"
                    ColumnSpacing="3"
                    Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <!-- Livraison (T2) : trois étapes sur un fil, le véhicule en pixels qui avance. -->
        <Grid x:Name="DeliveryTrack" Height="24" Margin="2,0,2,0" Visibility="Collapsed" SizeChanged="OnDeliveryTrackSizeChanged">
            <Border Height="2" VerticalAlignment="Bottom" Margin="0,0,0,4" CornerRadius="1" Background="{ThemeResource NfStrokeSubtleBrush}" />
            <Border x:Name="DeliveryDone" Height="2" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="0,0,0,4" CornerRadius="1" Width="0" Background="{ThemeResource NfTextPrimaryBrush}" />
            <Canvas x:Name="DeliveryCanvas" IsHitTestVisible="False" />
        </Grid>

        <!-- Salle vocale (T3) : une identicône par personne, allumée quand elle parle. -->
        <StackPanel x:Name="VoiceRow" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Visibility="Collapsed" />

        <!-- Miroir (W5) : la webcam au survol de « Rejoindre », et l'état du micro. -->
        <StackPanel x:Name="MirrorPanel" Spacing="6" HorizontalAlignment="Center" Visibility="Collapsed">
            <Border Width="208" Height="117" CornerRadius="{StaticResource NfCornerInner}" Background="#FF0A0A0A" BorderBrush="{ThemeResource NfStrokeSubtleBrush}" BorderThickness="1">
                <MediaPlayerElement x:Name="MirrorVideo" Stretch="UniformToFill" AreTransportControlsEnabled="False" IsHitTestVisible="False">
                    <MediaPlayerElement.RenderTransform>
                        <ScaleTransform ScaleX="-1" CenterX="104" />
                    </MediaPlayerElement.RenderTransform>
                </MediaPlayerElement>
            </Border>
            <TextBlock x:Name="MirrorStatus" HorizontalAlignment="Center" FontSize="11" Foreground="{ThemeResource NfTextSecondaryBrush}" />
        </StackPanel>

        <!--
            Rangée de contrôles, construite à partir des actions déclarées. Elle
            reste masquée tant qu'aucune action n'est annoncée : une carte sans
            contrôle ne doit pas réserver d'espace vide.
        -->
        <StackPanel
            x:Name="ActionHost"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Spacing="10"
            Visibility="Collapsed" />
    </StackPanel>
</UserControl>
