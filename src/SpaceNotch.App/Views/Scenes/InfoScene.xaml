<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SpaceNotch_App.Views.Scenes.InfoScene"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Scène générique : utilisée pour toute clé de scène qui n'a pas encore de
        vue dédiée (Bluetooth, et la carte destinée aux greffons). Elle évite
        qu'une fonctionnalité nouvelle doive modifier la fenêtre pour s'afficher.

        Elle rend les actions que la fonctionnalité déclare. Sans cela, un greffon
        tiers n'aurait aucun moyen d'exposer un contrôle : l'API lui permettrait de
        déclarer une action que personne n'afficherait.
    -->
    <StackPanel Padding="14,10,14,12" Spacing="8">

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Pastille d'icône : contour au trait, jamais de fond rempli.
                 Un fond légèrement plus clair serait une seconde surface, donc
                 une hiérarchie — et sur un objet de 38 DIP de côté, elle ne se
                 lit pas comme un plan mais comme une tache. -->
            <!-- La pastille porte, dans l'ordre de préférence : la grille
                 hypnotique d'un travail en cours, l'image de l'activité, son
                 glyphe. Elle est aussi le point d'arrivée du morphing depuis la
                 forme compacte. -->
            <Border
                x:Name="IconBadge"
                Grid.Column="0"
                Width="38"
                Height="38"
                CornerRadius="{StaticResource NfCornerInner}"
                Background="Transparent"
                BorderBrush="{ThemeResource NfStrokeStrongBrush}"
                BorderThickness="1"
                VerticalAlignment="Center">
                <Grid>
                    <FontIcon
                        x:Name="SceneIcon"
                        Glyph="&#xE946;"
                        FontSize="16"
                        Foreground="{ThemeResource NfTextPrimaryBrush}" />

                    <Image
                        x:Name="SceneArtwork"
                        Stretch="UniformToFill"
                        Visibility="Collapsed" />

                    <Grid
                        x:Name="SceneHypnoticHost"
                        Width="20"
                        Height="20"
                        IsHitTestVisible="False"
                        Visibility="Collapsed" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                <!-- Contexte discret au-dessus de l'état, comme dans la
                     référence : « Read app-sidebar.tsx · 219 lines ». -->
                <TextBlock
                    x:Name="EyebrowText"
                    Style="{StaticResource NfCaptionTextStyle}"
                    Foreground="{ThemeResource NfTextTertiaryBrush}"
                    Visibility="Collapsed" />

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="TitleText"
                    Text="Information"
                    FontSize="13.5"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource NfTextPrimaryBrush}"
                    TextTrimming="CharacterEllipsis"
                    MaxLines="1" />

                    <TextBlock
                        x:Name="MetricText"
                        Grid.Column="1"
                        Style="{StaticResource NfMetricTextStyle}"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />
                </Grid>

                <TextBlock
                    x:Name="SubtitleText"
                    Text=""
                    FontSize="11.5"
                    Foreground="{ThemeResource NfTextSecondaryBrush}"
                    TextTrimming="CharacterEllipsis"
                    MaxLines="2" />

                <!-- Progression : un fil, pas une barre de logiciel. Le
                     remplissage est une échelle, jamais une largeur recalculée. -->
                <Grid
                    x:Name="ProgressTrack"
                    Height="3"
                    Margin="0,4,0,0"
                    CornerRadius="1.5"
                    Background="{ThemeResource NfStrokeSubtleBrush}"
                    Visibility="Collapsed">
                    <Border
                        x:Name="ProgressFill"
                        CornerRadius="1.5"
                        Background="{ThemeResource NfTextPrimaryBrush}"
                        RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="ProgressScale" ScaleX="0" />
                        </Border.RenderTransform>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>

        <!--
            Rangée de contrôles, construite à partir des actions déclarées. Elle
            reste masquée tant qu'aucune action n'est annoncée : une carte sans
            contrôle ne doit pas réserver d'espace vide.
        -->
        <StackPanel
            x:Name="ActionHost"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Spacing="10"
            Visibility="Collapsed" />
    </StackPanel>
</UserControl>
