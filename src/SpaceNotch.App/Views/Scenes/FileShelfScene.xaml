<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SpaceNotch_App.Views.Scenes.FileShelfScene"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        L'étagère : une rangée de fichiers posés dans la notch, qu'on dépose en
        les glissant dessus et qu'on reprend en les glissant dehors — vers le
        bureau, un courriel, une autre application. C'est une étagère, pas une
        liste de logiciel.
    -->
    <Grid Padding="14,8,14,12" RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
            <TextBlock
                Text="Étagère"
                Style="{StaticResource NfCaptionTextStyle}"
                Foreground="{ThemeResource NfTextTertiaryBrush}" />
            <TextBlock
                x:Name="CountText"
                Text="0"
                Style="{StaticResource NfMetricTextStyle}" />
        </StackPanel>

        <ListView
            x:Name="FilesListView"
            Grid.Row="1"
            SelectionMode="None"
            CanDragItems="True"
            DragItemsStarting="OnDragItemsStarting"
            ScrollViewer.HorizontalScrollMode="Enabled"
            ScrollViewer.HorizontalScrollBarVisibility="Hidden"
            ScrollViewer.VerticalScrollMode="Disabled">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="68" Spacing="4" Padding="0,4,0,0">
                        <FontIcon
                            Glyph="&#xE8A5;"
                            FontSize="22"
                            Foreground="{ThemeResource NfTextSecondaryBrush}"
                            HorizontalAlignment="Center" />
                        <TextBlock
                            Text="{Binding FileName}"
                            Style="{StaticResource NfMicroTextStyle}"
                            Foreground="{ThemeResource NfTextPrimaryBrush}"
                            TextAlignment="Center"
                            HorizontalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            x:Name="EmptyText"
            Grid.Row="1"
            Text="Glissez un fichier sur la notch"
            Style="{StaticResource NfCaptionTextStyle}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
