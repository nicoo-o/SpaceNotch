<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SpaceNotch_App.Views.Scenes.FileShelfScene"
    xmlns:l="using:SpaceNotch_App.Views"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        L'étagère : les fichiers posés sur la notch, prêts à être repris en les
        glissant dehors. En-tête (nombre, « Tout vider »), puis une ligne de
        40 DIP par fichier : vraie icône, nom, taille, ✕ au survol. La liste ne
        touche jamais aux fichiers eux-mêmes. Voir w3-indicateurs.
    -->
    <Grid Padding="12,12,12,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="4,0,0,6">
            <TextBlock
                x:Name="HeaderText"
                FontSize="13.5"
                FontWeight="SemiBold"
                Foreground="{ThemeResource NfTextPrimaryBrush}"
                VerticalAlignment="Center" />
            <Button
                x:Name="ClearButton"
                HorizontalAlignment="Right"
                Style="{StaticResource NfChipButtonStyle}"
                Content="{l:Loc Fr='Tout vider', En='Clear all'}"
                AutomationProperties.Name="{l:Loc Fr='Vider l’étagère', En='Clear the shelf'}"
                Click="OnClearClicked" />
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollMode="Disabled"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="RowsPanel" />
        </ScrollViewer>

        <TextBlock
            x:Name="EmptyText"
            Grid.Row="1"
            Text="{l:Loc Fr='Glisse un fichier sur la notch', En='Drop a file on the notch'}"
            FontSize="12.5"
            Foreground="{ThemeResource NfTextTertiaryBrush}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
