<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SpaceNotch_App.Views.Scenes.MediaExpandedScene"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="12,10,12,14" ColumnSpacing="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Pochette, avec repli sur une icône si le média n'en expose aucune -->
        <Border
            x:Name="ArtworkBorder"
            Grid.Column="0"
            Width="76"
            Height="76"
            CornerRadius="14"
            Background="{ThemeResource NfSurfaceElevatedBrush}"
            VerticalAlignment="Center">
            <Grid>
                <Image x:Name="ArtworkImage" Stretch="UniformToFill" />
                <FontIcon
                    x:Name="ArtworkFallback"
                    Glyph="&#xE8D6;"
                    FontSize="32"
                    Foreground="{ThemeResource NfTextTertiaryBrush}" />
            </Grid>
        </Border>

        <!-- Colonne droite : titre, artiste, timeline, transport -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock
                x:Name="TitleText"
                Text="Titre de la chanson"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{ThemeResource NfTextPrimaryBrush}"
                TextTrimming="CharacterEllipsis"
                MaxLines="1" />

            <TextBlock
                x:Name="ArtistText"
                Text="Nom de l'artiste"
                FontSize="11.5"
                Foreground="{ThemeResource NfTextSecondaryBrush}"
                TextTrimming="CharacterEllipsis"
                MaxLines="1" />

            <!--
                Timeline interactive : la progression est présentée par la
                fonctionnalité, et tout déplacement volontaire lui est renvoyé sous
                forme d'action. La vue ne commande jamais la lecture elle-même.
            -->
            <Grid ColumnSpacing="8" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Slider
                    x:Name="TimelineSlider"
                    Grid.Column="0"
                    Minimum="0"
                    Maximum="100"
                    Value="0"
                    StepFrequency="1"
                    VerticalAlignment="Center"
                    ValueChanged="OnTimelineValueChanged" />

                <TextBlock
                    x:Name="TimeText"
                    Grid.Column="1"
                    Text="0:00 / 0:00"
                    FontSize="9.5"
                    Typography.NumeralAlignment="Tabular"
                    Foreground="{ThemeResource NfTextTertiaryBrush}"
                    VerticalAlignment="Center" />
            </Grid>

            <!-- Contrôles : activés selon les actions réellement déclarées -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="14" Margin="0,2,0,0">
                <Button
                    Style="{StaticResource NfSecondaryButtonStyle}"
                    x:Name="PrevButton"
                    Width="32"
                    Height="32"
                    CornerRadius="16"
                    Padding="0"
                    Background="{ThemeResource NfSurfaceElevatedBrush}"
                    BorderThickness="0"
                    ToolTipService.ToolTip="Piste précédente"
                    AutomationProperties.Name="Piste précédente"
                    Click="OnPrevClicked">
                    <FontIcon Glyph="&#xE892;" FontSize="12" Foreground="{ThemeResource NfTextPrimaryBrush}" />
                </Button>

                <Button
                    Style="{StaticResource NfPlayButtonStyle}"
                    x:Name="PlayPauseButton"
                    Width="36"
                    Height="36"
                    CornerRadius="18"
                    Padding="0"
                    Background="{ThemeResource NfTextPrimaryBrush}"
                    BorderThickness="0"
                    ToolTipService.ToolTip="Lecture ou pause"
                    AutomationProperties.Name="Lecture ou pause"
                    Click="OnPlayPauseClicked">
                    <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE769;" FontSize="14" Foreground="{ThemeResource NfSurfaceBaseBrush}" />
                </Button>

                <Button
                    Style="{StaticResource NfSecondaryButtonStyle}"
                    x:Name="NextButton"
                    Width="32"
                    Height="32"
                    CornerRadius="16"
                    Padding="0"
                    Background="{ThemeResource NfSurfaceElevatedBrush}"
                    BorderThickness="0"
                    ToolTipService.ToolTip="Piste suivante"
                    AutomationProperties.Name="Piste suivante"
                    Click="OnNextClicked">
                    <FontIcon Glyph="&#xE893;" FontSize="12" Foreground="{ThemeResource NfTextPrimaryBrush}" />
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
