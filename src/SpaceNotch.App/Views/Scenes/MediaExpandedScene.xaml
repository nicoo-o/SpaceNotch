<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SpaceNotch_App.Views.Scenes.MediaExpandedScene"
    xmlns:l="using:SpaceNotch_App.Views"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:SpaceNotch_App.Views"
    mc:Ignorable="d">

    <Grid Padding="{StaticResource NfScenePadding}" ColumnSpacing="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Pochette, avec repli sur une icône si le média n'en expose aucune -->
        <Border
            x:Name="ArtworkBorder"
            Grid.Column="0"
            Width="76"
            Height="76"
            CornerRadius="14"
            Background="{ThemeResource NfSurfaceElevatedBrush}"
            VerticalAlignment="Center"
            PointerMoved="OnArtworkPointerMoved"
            PointerExited="OnArtworkPointerExited">
            <!-- Pochette en 3D (S2) : elle s'incline vers le curseur, ±8° au plus. -->
            <Border.Projection>
                <PlaneProjection x:Name="ArtworkTilt" />
            </Border.Projection>
            <Grid>
                <Image x:Name="ArtworkImage" Stretch="UniformToFill" />
                <views:GlyphView
                    x:Name="ArtworkFallback"
                    Key="Music"
                    Size="28"
                    Tint="{ThemeResource NfTextTertiaryBrush}" />

                <!-- Reflet de papier glacé qui suit le pointeur. -->
                <Border x:Name="ArtworkShine" Opacity="0" IsHitTestVisible="False">
                    <Border.Background>
                        <RadialGradientBrush x:Name="ArtworkShineBrush" RadiusX="0.7" RadiusY="0.7" Center="0.5,0.5" GradientOrigin="0.5,0.5">
                            <GradientStop Color="#40FFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>
        </Border>

        <!-- Colonne droite : titre, artiste, timeline, transport -->
        <StackPanel x:Name="ControlsPanel" Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock
                x:Name="TitleText"
                Text="{l:Loc Fr='Titre de la chanson', En='Song title'}"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{ThemeResource NfTextPrimaryBrush}"
                TextTrimming="CharacterEllipsis"
                MaxLines="1" />

            <TextBlock
                x:Name="ArtistText"
                Text="{l:Loc Fr='Nom de l’artiste', En='Artist name'}"
                FontSize="11.5"
                Foreground="{ThemeResource NfTextSecondaryBrush}"
                TextTrimming="CharacterEllipsis"
                MaxLines="1" />

            <!--
                Timeline interactive : la progression est présentée par la
                fonctionnalité, et tout déplacement volontaire lui est renvoyé sous
                forme d'action. La vue ne commande jamais la lecture elle-même.
            -->
            <Grid x:Name="TimelineRow" ColumnSpacing="8" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Slider
                    x:Name="TimelineSlider"
                    Grid.Column="0"
                    Minimum="0"
                    Maximum="100"
                    Value="0"
                    StepFrequency="1"
                    VerticalAlignment="Center"
                    ValueChanged="OnTimelineValueChanged" />

                <TextBlock
                    x:Name="TimeText"
                    Grid.Column="1"
                    Text="0:00 / 0:00"
                    FontSize="9.5"
                    Typography.NumeralAlignment="Tabular"
                    Foreground="{ThemeResource NfTextTertiaryBrush}"
                    VerticalAlignment="Center" />
            </Grid>

            <!-- Durée inconnue (une radio, une vidéo dans un navigateur) : pas de
                 « 0:00 / 0:00 », mais ce qui est vrai — ça joue, et où. -->
            <StackPanel
                x:Name="LiveRow"
                Orientation="Horizontal"
                Spacing="8"
                Margin="0,8,0,0"
                Visibility="Collapsed">
                <views:TrailingView x:Name="LiveBars" VerticalAlignment="Center" />
                <TextBlock
                    x:Name="LiveText"
                    FontSize="11"
                    Foreground="{ThemeResource NfTextTertiaryBrush}"
                    VerticalAlignment="Center" />
            </StackPanel>

            <!-- Contrôles : activés selon les actions réellement déclarées -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="14" Margin="0,2,0,0">
                <Button
                    Style="{StaticResource NfSecondaryButtonStyle}"
                    x:Name="PrevButton"
                    Width="32"
                    Height="32"
                    CornerRadius="16"
                    Padding="0"
                    Background="{ThemeResource NfSurfaceElevatedBrush}"
                    BorderThickness="0"
                    ToolTipService.ToolTip="{l:Loc Fr='Piste précédente', En='Previous track'}"
                    AutomationProperties.Name="{l:Loc Fr='Piste précédente', En='Previous track'}"
                    Click="OnPrevClicked">
                    <views:GlyphView Key="Previous" Size="14" Tint="{ThemeResource NfTextPrimaryBrush}" />
                </Button>

                <Button
                    Style="{StaticResource NfPlayButtonStyle}"
                    x:Name="PlayPauseButton"
                    Width="36"
                    Height="36"
                    CornerRadius="18"
                    Padding="0"
                    Background="{ThemeResource NfTextPrimaryBrush}"
                    BorderThickness="0"
                    ToolTipService.ToolTip="{l:Loc Fr='Lecture ou pause', En='Play or pause'}"
                    AutomationProperties.Name="{l:Loc Fr='Lecture ou pause', En='Play or pause'}"
                    Click="OnPlayPauseClicked">
                    <views:GlyphView x:Name="PlayPauseIcon" Key="Pause" Size="14" Tint="{ThemeResource NfSurfaceBaseBrush}" />
                </Button>

                <Button
                    Style="{StaticResource NfSecondaryButtonStyle}"
                    x:Name="NextButton"
                    Width="32"
                    Height="32"
                    CornerRadius="16"
                    Padding="0"
                    Background="{ThemeResource NfSurfaceElevatedBrush}"
                    BorderThickness="0"
                    ToolTipService.ToolTip="{l:Loc Fr='Piste suivante', En='Next track'}"
                    AutomationProperties.Name="{l:Loc Fr='Piste suivante', En='Next track'}"
                    Click="OnNextClicked">
                    <views:GlyphView Key="Next" Size="14" Tint="{ThemeResource NfTextPrimaryBrush}" />
                </Button>

                <!-- « J'aime » sur Spotify (T4), seulement une fois connecté. -->
                <Button
                    Style="{StaticResource NfSecondaryButtonStyle}"
                    x:Name="LikeButton"
                    Width="32"
                    Height="32"
                    CornerRadius="16"
                    Padding="0"
                    Background="{ThemeResource NfSurfaceElevatedBrush}"
                    BorderThickness="0"
                    Visibility="Collapsed"
                    ToolTipService.ToolTip="{l:Loc Fr='J’aime sur Spotify', En='Like on Spotify'}"
                    AutomationProperties.Name="{l:Loc Fr='J’aime sur Spotify', En='Like on Spotify'}"
                    Click="OnLikeClicked">
                    <views:GlyphView x:Name="LikeIcon" Key="Heart" Size="14" Tint="{ThemeResource NfTextSecondaryBrush}" />
                </Button>

                <!-- Retour au mode paroles, quand le morceau en a. -->
                <Button
                    Style="{StaticResource NfSecondaryButtonStyle}"
                    x:Name="LyricsButton"
                    Width="32"
                    Height="32"
                    CornerRadius="16"
                    Padding="0"
                    Background="{ThemeResource NfSurfaceElevatedBrush}"
                    BorderThickness="0"
                    Visibility="Collapsed"
                    ToolTipService.ToolTip="{l:Loc Fr='Paroles', En='Lyrics'}"
                    AutomationProperties.Name="{l:Loc Fr='Paroles', En='Lyrics'}"
                    Click="OnLyricsClicked">
                    <views:GlyphView Key="Text" Size="14" Tint="{ThemeResource NfTextPrimaryBrush}" />
                </Button>
            </StackPanel>
        </StackPanel>

        <!--
            Mode paroles (T4) : la ligne chantée en grand, la suivante en gris,
            qui remontent en rythme ; à droite, « J'aime » et la file Spotify.
            Un clic sur les paroles rend les contrôles.
        -->
        <Grid
            x:Name="LyricsPanel"
            Grid.Column="1"
            ColumnSpacing="14"
            VerticalAlignment="Center"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="LyricsViewport"
                Style="{StaticResource NfGhostButtonStyle}"
                Height="56"
                Padding="0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Top"
                ToolTipService.ToolTip="{l:Loc Fr='Afficher les contrôles', En='Show the controls'}"
                AutomationProperties.Name="{l:Loc Fr='Paroles, afficher les contrôles', En='Lyrics, show the controls'}"
                Click="OnLyricsViewportClicked">
                <!-- Un Canvas ne coupe rien de lui-même : le découpage suit sa taille. -->
                <Canvas x:Name="LyricsClipHost" Height="56" SizeChanged="OnLyricsHostSizeChanged">
                    <StackPanel x:Name="LyricsList" Spacing="4">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="LyricsShift" />
                        </StackPanel.RenderTransform>
                    </StackPanel>
                </Canvas>
            </Button>

            <StackPanel
                x:Name="LyricsSide"
                Grid.Column="1"
                Spacing="6"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Visibility="Collapsed">
                <Button
                    x:Name="LyricsLikeButton"
                    Style="{StaticResource NfGhostButtonStyle}"
                    Width="26"
                    Height="26"
                    Padding="0"
                    HorizontalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="{l:Loc Fr='J’aime sur Spotify', En='Like on Spotify'}"
                    AutomationProperties.Name="{l:Loc Fr='J’aime sur Spotify', En='Like on Spotify'}"
                    Click="OnLikeClicked">
                    <views:GlyphView x:Name="LyricsLikeIcon" Key="Heart" Size="14" Tint="#88FFFFFF" />
                </Button>
                <Button
                    x:Name="QueueButton"
                    Style="{StaticResource NfGhostButtonStyle}"
                    Padding="6,1,6,2"
                    MinHeight="0"
                    MinWidth="0"
                    HorizontalAlignment="Center"
                    Background="Transparent"
                    BorderBrush="#2AFFFFFF"
                    BorderThickness="1"
                    CornerRadius="5"
                    ToolTipService.ToolTip="{l:Loc Fr='Ajouter à la file Spotify', En='Add to the Spotify queue'}"
                    AutomationProperties.Name="{l:Loc Fr='Ajouter à la file Spotify', En='Add to the Spotify queue'}"
                    Click="OnQueueClicked">
                    <TextBlock
                        x:Name="QueueText"
                        Text="{l:Loc Fr='file', En='queue'}"
                        FontFamily="Consolas"
                        FontSize="10.5"
                        Foreground="#B3FFFFFF" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
