<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SpaceNotch_App.Views.Scenes.VolumeHudScene"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="14,10,14,12" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            x:Name="IconBorder"
            Grid.Column="0"
            Width="38"
            Height="38"
            CornerRadius="12"
            Background="#1C2028"
            VerticalAlignment="Center">
            <FontIcon x:Name="VolumeIcon" Glyph="&#xE995;" FontSize="18" Foreground="#FFFFFF" />
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
            <Grid>
                <TextBlock
                    x:Name="VolumeLabel"
                    Text="Volume"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#FFFFFF" />
                <TextBlock
                    x:Name="VolumePercent"
                    Text="65%"
                    FontSize="12"
                    FontWeight="Bold"
                    Foreground="#4EA1FF"
                    HorizontalAlignment="Right" />
            </Grid>

            <ProgressBar
                x:Name="VolumeBar"
                Height="5"
                CornerRadius="2.5"
                Value="65"
                Maximum="100"
                Foreground="#4EA1FF"
                Background="#25FFFFFF" />
        </StackPanel>
    </Grid>
</UserControl>
