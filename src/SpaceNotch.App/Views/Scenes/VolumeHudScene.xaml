<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SpaceNotch_App.Views.Scenes.VolumeHudScene"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Retour système ouvert : la valeur devient la matière principale.

        Pas de pastille remplie, pas de couleur d'accent : le glyphe, la valeur
        en grand et un fil de niveau. La valeur défile vers sa cible au lieu de
        sauter, en chiffres à chasse fixe pour que sa largeur ne danse pas.
    -->
    <Grid Padding="16,8,16,12" ColumnSpacing="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <FontIcon
            x:Name="VolumeIcon"
            Grid.Column="0"
            Glyph="&#xE995;"
            FontSize="20"
            Foreground="{ThemeResource NfTextPrimaryBrush}"
            VerticalAlignment="Center" />

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="VolumeValue"
                    Grid.Column="0"
                    Text="65"
                    Style="{StaticResource NfHeroTextStyle}"
                    VerticalAlignment="Bottom" />

                <TextBlock
                    x:Name="VolumeLabel"
                    Grid.Column="1"
                    Text="Volume"
                    Style="{StaticResource NfCaptionTextStyle}"
                    Margin="0,0,0,5"
                    VerticalAlignment="Bottom" />
            </Grid>

            <!-- Fil de niveau : une échelle, jamais une largeur recalculée. -->
            <Grid
                Height="3"
                CornerRadius="1.5"
                Background="{ThemeResource NfStrokeStrongBrush}">
                <Border
                    CornerRadius="1.5"
                    Background="{ThemeResource NfTextPrimaryBrush}"
                    RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="LevelScale" ScaleX="0.65" />
                    </Border.RenderTransform>
                </Border>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
