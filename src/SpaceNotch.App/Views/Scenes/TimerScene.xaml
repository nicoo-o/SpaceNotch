<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SpaceNotch_App.Views.Scenes.TimerScene"
    xmlns:l="using:SpaceNotch_App.Views"
    xmlns:views="using:SpaceNotch_App.Views"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="{StaticResource NfScenePadding}" RowSpacing="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            Chiffres tabulaires et police d'affichage : sans cela, chaque seconde
            ferait bouger la largeur du texte, ce qui produirait un tremblement
            désagréable pour un compteur qui bat toutes les secondes.
        -->
        <TextBlock
            x:Name="TimeText"
            Grid.Row="0"
            Text="25:00"
            FontFamily="Segoe UI Variable Display"
            FontSize="28"
            FontWeight="SemiBold"
            Foreground="{ThemeResource NfTextPrimaryBrush}"
            HorizontalAlignment="Center"
            TextAlignment="Center" />

        <TextBlock
            x:Name="ModeText"
            Grid.Row="1"
            Text="Focus"
            FontSize="10.5"
            CharacterSpacing="120"
            Foreground="{ThemeResource NfTextTertiaryBrush}"
            HorizontalAlignment="Center" />

        <!-- Focus calé (W3) : la raison du raccourci, comme dans la maquette. -->
        <TextBlock
            x:Name="NoteText"
            Grid.Row="2"
            FontSize="11.5"
            Foreground="{ThemeResource NfTextSecondaryBrush}"
            HorizontalAlignment="Center"
            TextTrimming="CharacterEllipsis"
            Visibility="Collapsed" />

        <StackPanel
            Grid.Row="3"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Spacing="10"
            Margin="0,6,0,0">

            <!-- Contrôles au trait, jamais remplis : sur une carte noire, une
                 pastille blanche attire plus que le chiffre qu'elle commande. -->
            <Button
                Style="{StaticResource NfGhostButtonStyle}"
                x:Name="ToggleButton"
                Width="30"
                Height="30"
                CornerRadius="15"
                Padding="0"
                Background="Transparent"
                BorderThickness="1"
                BorderBrush="{ThemeResource NfStrokeStrongBrush}"
                ToolTipService.ToolTip="{l:Loc Fr='Démarrer ou suspendre', En='Start or pause'}"
                Click="OnToggleClicked">
                <views:GlyphView
                    x:Name="ToggleIcon"
                    Key="Play"
                    Size="14"
                    Tint="{ThemeResource NfTextPrimaryBrush}" />
            </Button>

            <Button
                Style="{StaticResource NfGhostButtonStyle}"
                x:Name="ResetButton"
                Width="30"
                Height="30"
                CornerRadius="15"
                Padding="0"
                Background="Transparent"
                BorderThickness="1"
                BorderBrush="{ThemeResource NfStrokeSubtleBrush}"
                ToolTipService.ToolTip="{l:Loc Fr='Remettre à zéro', En='Reset'}"
                Click="OnResetClicked">
                <views:GlyphView
                    Key="Reset"
                    Size="14"
                    Tint="{ThemeResource NfTextSecondaryBrush}" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
