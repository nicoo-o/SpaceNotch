<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SpaceNotch_App.Views.Scenes.BluetoothScene"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:SpaceNotch_App.Views"
    mc:Ignorable="d">

    <!-- Appareil Bluetooth : icône, nom, état, anneau de batterie. -->
    <Grid Padding="18,0,18,0" ColumnSpacing="12" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border
            x:Name="IconPlate"
            Width="34"
            Height="34"
            CornerRadius="10"
            Background="{ThemeResource NfControlFillBrush}">
            <views:GlyphView x:Name="KindIcon" Size="16" FallbackKey="Bluetooth" Tint="{ThemeResource NfTextPrimaryBrush}" />
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
            <TextBlock
                x:Name="NameText"
                FontSize="13.5"
                FontWeight="SemiBold"
                Foreground="{ThemeResource NfTextPrimaryBrush}"
                TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal" Spacing="5">
                <Ellipse x:Name="StateDot" Width="6" Height="6" Fill="{ThemeResource NfActiveBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="StateText" FontSize="11.5" Foreground="{ThemeResource NfTextSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <Grid x:Name="BatteryHost" Grid.Column="2" Width="34" Height="34" Visibility="Collapsed">
            <Ellipse Stroke="{ThemeResource NfStrokeStrongBrush}" StrokeThickness="3" Margin="1.5" />
            <Path
                x:Name="BatteryArc"
                StrokeThickness="3"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round" />
            <TextBlock
                x:Name="BatteryText"
                FontSize="9.5"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource NfTextPrimaryBrush}" />
        </Grid>
    </Grid>
</UserControl>
