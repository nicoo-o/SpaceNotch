<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NotchFlow_App.Views.Scenes.TimerScene"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="16,8,16,12" RowSpacing="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            Chiffres tabulaires et police d'affichage : sans cela, chaque seconde
            ferait bouger la largeur du texte, ce qui produirait un tremblement
            désagréable pour un compteur qui bat toutes les secondes.
        -->
        <TextBlock
            x:Name="TimeText"
            Grid.Row="0"
            Text="25:00"
            FontFamily="Segoe UI Variable Display"
            FontSize="28"
            FontWeight="SemiBold"
            Foreground="{ThemeResource NfTextPrimaryBrush}"
            HorizontalAlignment="Center"
            TextAlignment="Center" />

        <TextBlock
            x:Name="ModeText"
            Grid.Row="1"
            Text="Focus"
            FontSize="10.5"
            CharacterSpacing="120"
            Foreground="{ThemeResource NfTextTertiaryBrush}"
            HorizontalAlignment="Center" />

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Spacing="10"
            Margin="0,6,0,0">

            <!-- Contrôles au trait, jamais remplis : sur une carte noire, une
                 pastille blanche attire plus que le chiffre qu'elle commande. -->
            <Button
                x:Name="ToggleButton"
                Width="30"
                Height="30"
                CornerRadius="15"
                Padding="0"
                Background="Transparent"
                BorderThickness="1"
                BorderBrush="{ThemeResource NfStrokeStrongBrush}"
                ToolTipService.ToolTip="Démarrer ou suspendre"
                Click="OnToggleClicked">
                <FontIcon
                    x:Name="ToggleIcon"
                    Glyph="&#xE768;"
                    FontSize="11"
                    Foreground="{ThemeResource NfTextPrimaryBrush}" />
            </Button>

            <Button
                x:Name="ResetButton"
                Width="30"
                Height="30"
                CornerRadius="15"
                Padding="0"
                Background="Transparent"
                BorderThickness="1"
                BorderBrush="{ThemeResource NfStrokeSubtleBrush}"
                ToolTipService.ToolTip="Remettre à zéro"
                Click="OnResetClicked">
                <FontIcon
                    Glyph="&#xE777;"
                    FontSize="11"
                    Foreground="{ThemeResource NfTextSecondaryBrush}" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
