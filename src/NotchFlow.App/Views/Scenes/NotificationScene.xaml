<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NotchFlow_App.Views.Scenes.NotificationScene"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="14,10,14,12" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Width="38"
            Height="38"
            CornerRadius="12"
            Background="#1C2028"
            VerticalAlignment="Center">
            <FontIcon Glyph="&#xE91C;" FontSize="18" Foreground="#4EA1FF" />
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock
                x:Name="AppSourceText"
                Text="Application"
                FontSize="10.5"
                FontWeight="Bold"
                Foreground="#4EA1FF"
                TextTrimming="CharacterEllipsis" />

            <TextBlock
                x:Name="TitleText"
                Text="Titre de la notification"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="#FFFFFF"
                TextTrimming="CharacterEllipsis" />

            <TextBlock
                x:Name="BodyText"
                Text="Message..."
                FontSize="11"
                Foreground="#99FFFFFF"
                TextTrimming="CharacterEllipsis"
                MaxLines="2" />
        </StackPanel>

        <Button
            x:Name="CloseButton"
            Grid.Column="2"
            Width="28"
            Height="28"
            CornerRadius="14"
            Padding="0"
            Background="#14FFFFFF"
            BorderThickness="0"
            VerticalAlignment="Top"
            Click="OnCloseClicked">
            <FontIcon Glyph="&#xE8BB;" FontSize="10" Foreground="#FFFFFF" />
        </Button>
    </Grid>
</UserControl>
