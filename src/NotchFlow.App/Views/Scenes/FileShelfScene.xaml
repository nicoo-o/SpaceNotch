<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NotchFlow_App.Views.Scenes.FileShelfScene"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="14,10,14,12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8B7;" FontSize="13" Foreground="#4EA1FF" />
                <TextBlock
                    Text="File Shelf"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#FFFFFF" />
            </StackPanel>
            <TextBlock
                x:Name="CountText"
                Text="0 fichier"
                FontSize="11"
                Foreground="#80FFFFFF"
                HorizontalAlignment="Right"
                VerticalAlignment="Center" />
        </Grid>

        <!-- Liste des fichiers -->
        <ListView
            x:Name="FilesListView"
            Grid.Row="1"
            MaxHeight="80"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="4,4,4,4" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8A5;" FontSize="12" Foreground="#80FFFFFF" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FileName}" FontSize="11" FontWeight="Medium" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding FormattedSize}" FontSize="9.5" Foreground="#70FFFFFF" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
