<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="NotchFlow_App.Windows.SatelliteWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:winuiex="using:WinUIEx"
    Title="NotchFlow Satellite"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <winuiex:TransparentTintBackdrop />
    </Window.SystemBackdrop>

    <!--
        Le satellite est un objet distinct, et sa fenêtre l'est aussi : une fenêtre
        unique contenant l'Island, le vide et le satellite ne peut pas laisser
        passer les clics dans le vide, Windows ne faisant traverser HTTRANSPARENT
        qu'entre fenêtres d'un même thread. Ici, le vide entre les deux lobes
        n'appartient à aucune fenêtre — les clics y atteignent donc naturellement
        ce qui se trouve derrière. Voir ADR-015.
    -->
    <Grid
        x:Name="SatelliteRoot"
        Background="Transparent"
        PointerPressed="OnSatellitePressed">

        <!--
            Le disque reprend exactement la surface de l'Island et son reflet : deux
            objets du même système doivent se lire comme tels, sinon le satellite
            passe pour une décoration rapportée.
        -->
        <Grid
            x:Name="Disc"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            RenderTransformOrigin="0.5,0.5">

            <Grid.RenderTransform>
                <TranslateTransform x:Name="DiscShift" />
            </Grid.RenderTransform>

            <Ellipse Fill="{ThemeResource NfSurfaceBaseBrush}" />

            <Ellipse Opacity="{ThemeResource NfSpecularOpacity}">
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#FFFFFF" Offset="0.0" />
                        <GradientStop Color="#00FFFFFF" Offset="0.6" />
                    </LinearGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <FontIcon
                x:Name="SatelliteGlyph"
                FontSize="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
