<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="NotchFlow_App.Windows.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="NotchFlow — Réglages"
    mc:Ignorable="d">

    <Grid x:Name="RootLayout" Background="#0F0F12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            Aperçu en direct. Il est mis à jour par le même signal que l'Island
            elle-même : l'aperçu ne peut donc pas montrer autre chose que ce que
            l'utilisateur obtient réellement.
        -->
        <Grid Grid.Row="0" Height="200" Background="#08080A">
            <StackPanel
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Spacing="12">

                <!--
                    Les trois paliers, à taille réelle, côte à côte.

                    Un rayon ne se juge pas sur une forme unique : 12 DIP sur un
                    palier de 28 donnent une pastille, et le même rayon sur une
                    carte de 52 donnent un panneau. C'est précisément ce que
                    l'aperçu doit montrer, sinon l'utilisateur règle un nombre
                    sans voir lequel des trois il est en train de changer.

                    Les congés sont ici des arcs et non des superellipses, et
                    l'écart est assumé : à 12 DIP, la différence entre les deux
                    courbes est inférieure au pixel en dehors de la jonction, qui
                    n'est pas mesurable à cette échelle d'aperçu.
                -->
                <StackPanel Orientation="Horizontal" Spacing="8">

                    <!-- Veille -->
                    <Border
                        x:Name="PreviewIdle"
                        Width="34"
                        Height="28"
                        CornerRadius="0,0,12,12"
                        Background="#F20B0B0D"
                        VerticalAlignment="Bottom">
                        <Ellipse
                            Width="6"
                            Height="6"
                            Fill="#B8FFFFFF"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>

                    <!-- Signal -->
                    <Border
                        x:Name="PreviewSignal"
                        Width="132"
                        Height="28"
                        CornerRadius="0,0,12,12"
                        Background="#F20B0B0D"
                        VerticalAlignment="Bottom">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8D6;" FontSize="14" Foreground="#7FB3F0" VerticalAlignment="Center" />
                            <TextBlock
                                Text="En lecture"
                                FontSize="11.5"
                                FontWeight="SemiBold"
                                Foreground="#F0FFFFFF"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Carte : deux lignes -->
                    <Border
                        x:Name="PreviewCard"
                        Width="240"
                        Height="52"
                        CornerRadius="0,0,12,12"
                        Background="#F20B0B0D"
                        VerticalAlignment="Bottom">
                        <Grid x:Name="PreviewCardBody" Margin="14,10,14,10" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                Glyph="&#xE916;"
                                FontSize="20"
                                Foreground="#E8A66B"
                                VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock
                                    Text="Focus · En cours"
                                    FontSize="11"
                                    LineHeight="14"
                                    Foreground="#9EFFFFFF" />
                                <TextBlock
                                    Text="24:37 restantes"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    LineHeight="16"
                                    Foreground="#F0FFFFFF"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!--
                    Forme déployée : c'est là que le rayon se juge vraiment, sur
                    une surface large où le congé n'est plus une fraction
                    importante de la hauteur.
                -->
                <Border
                    x:Name="PreviewExpanded"
                    Width="320"
                    Height="104"
                    CornerRadius="0,0,12,12"
                    Background="#E60B0B0D"
                    Opacity="0.82">
                    <TextBlock
                        x:Name="PreviewExpandedText"
                        Text="Island ouverte"
                        FontSize="11"
                        Foreground="#CCFFFFFF"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Border>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="20,16,20,12">
            <StackPanel Spacing="6">

                <!-- Apparence -->
                <TextBlock Text="APPARENCE" FontSize="10.5" FontWeight="Bold" CharacterSpacing="120" Foreground="#70FFFFFF" Margin="0,4,0,2" />
                <ComboBox x:Name="AppearanceBox" Header="Thème" HorizontalAlignment="Stretch" SelectionChanged="OnAppearanceChanged" />
                <ComboBox x:Name="BackdropBox" Header="Fond de l'Island" HorizontalAlignment="Stretch" SelectionChanged="OnBackdropChanged" />

                <!-- Géométrie -->
                <TextBlock Text="GÉOMÉTRIE" FontSize="10.5" FontWeight="Bold" CharacterSpacing="120" Foreground="#70FFFFFF" Margin="0,14,0,2" />

                <!--
                    La densité remplace les anciennes largeur et hauteur.

                    Une hauteur réglable au pixel près permettait de séparer les
                    deux lignes d'une carte jusqu'à en faire un panneau vide, et
                    une largeur libre laissait fabriquer une forme où le texte
                    n'avait plus de place. Trois densités déplacent les dimensions
                    ensemble et gardent les proportions du langage visuel.
                -->
                <ComboBox x:Name="DensityBox" Header="Densité des cartes" HorizontalAlignment="Stretch" SelectionChanged="OnDensityChanged" />

                <Grid>
                    <TextBlock Text="Rayon des congés" FontSize="12" Foreground="#E0FFFFFF" />
                    <TextBlock x:Name="RadiusValue" FontSize="12" Foreground="#4EA1FF" HorizontalAlignment="Right" />
                </Grid>
                <!--
                    Maximum est toujours écrit AVANT Minimum. Un curseur dont le
                    minimum dépasse le maximum par défaut — 100 pour un RangeBase —
                    fait lever le constructeur XAML : la fenêtre ne s'ouvre alors
                    pas du tout, avec un message qui ne dit pas quel contrôle est
                    en cause.
                -->
                <Slider x:Name="RadiusSlider" Maximum="24" Minimum="4" StepFrequency="1" ValueChanged="OnRadiusChanged" />

                <ToggleSwitch
                    x:Name="SmoothingToggle"
                    Header="Congés continus (superellipse)"
                    OnContent="Squircle"
                    OffContent="Arc de cercle"
                    Toggled="OnSmoothingToggled" />

                <Grid>
                    <TextBlock Text="Décalage vertical" FontSize="12" Foreground="#E0FFFFFF" />
                    <TextBlock x:Name="TopOffsetValue" FontSize="12" Foreground="#4EA1FF" HorizontalAlignment="Right" />
                </Grid>
                <Slider x:Name="TopOffsetSlider" Maximum="120" Minimum="-20" StepFrequency="1" ValueChanged="OnTopOffsetChanged" />

                <!-- Animation -->
                <TextBlock Text="ANIMATION" FontSize="10.5" FontWeight="Bold" CharacterSpacing="120" Foreground="#70FFFFFF" Margin="0,14,0,2" />
                <ToggleSwitch x:Name="BouncyToggle" Header="Rebond du ressort" OnContent="Autorisé" OffContent="Neutre" Toggled="OnBouncyToggled" />

                <!--
                    Deux nombres au lieu de trois, et nommés pour ce qu'ils font.

                    « Raideur 220, amortissement 22, masse 1 » ne décrit pas un
                    mouvement : les trois se combinent, et deux d'entre eux font
                    largement la même chose. Le temps de réaction et le rebond, eux,
                    se lisent directement, se comparent, et sont le vocabulaire des
                    systèmes de mouvement d'aujourd'hui. La masse n'est plus offerte
                    parce qu'à elle seule elle n'agit pas.
                -->
                <Grid>
                    <TextBlock Text="Vitesse" FontSize="12" Foreground="#E0FFFFFF" />
                    <TextBlock x:Name="ResponseValue" FontSize="12" Foreground="#4EA1FF" HorizontalAlignment="Right" />
                </Grid>
                <Slider x:Name="ResponseSlider" Maximum="0.8" Minimum="0.25" StepFrequency="0.01" ValueChanged="OnResponseChanged" />

                <Grid>
                    <TextBlock Text="Rebond" FontSize="12" Foreground="#E0FFFFFF" />
                    <TextBlock x:Name="BounceValue" FontSize="12" Foreground="#4EA1FF" HorizontalAlignment="Right" />
                </Grid>
                <Slider x:Name="BounceSlider" Maximum="1.1" Minimum="0.3" StepFrequency="0.01" ValueChanged="OnBounceChanged" />

                <!-- Placement -->
                <TextBlock Text="PLACEMENT" FontSize="10.5" FontWeight="Bold" CharacterSpacing="120" Foreground="#70FFFFFF" Margin="0,14,0,2" />
                <ComboBox x:Name="DisplayBox" Header="Écran" HorizontalAlignment="Stretch" SelectionChanged="OnDisplayModeChanged" />
                <ComboBox x:Name="CutoutBox" Header="Découpe caméra" HorizontalAlignment="Stretch" SelectionChanged="OnCutoutChanged" />

                <!-- Fonctionnalités -->
                <TextBlock Text="FONCTIONNALITÉS" FontSize="10.5" FontWeight="Bold" CharacterSpacing="120" Foreground="#70FFFFFF" Margin="0,14,0,2" />
                <TextBlock
                    Text="Une fonctionnalité désactivée libère ses écouteurs système : elle ne consomme plus rien."
                    FontSize="11"
                    Foreground="#80FFFFFF"
                    TextWrapping="Wrap"
                    Margin="0,0,0,4" />

                <StackPanel x:Name="FeaturesHost" Spacing="2" />

                <!-- Comportement -->
                <TextBlock Text="COMPORTEMENT" FontSize="10.5" FontWeight="Bold" CharacterSpacing="120" Foreground="#70FFFFFF" Margin="0,14,0,2" />
                <ToggleSwitch x:Name="HoverToggle" Header="Aperçu au survol" Toggled="OnHoverToggled" />
                <ToggleSwitch x:Name="StartupToggle" Header="Démarrer avec Windows" Toggled="OnStartupToggled" />
                <ToggleSwitch x:Name="StackToggle" Header="Indicateur de pile d'activités" Toggled="OnStackToggled" />
                <ToggleSwitch x:Name="SatelliteToggle" Header="Satellite détaché" Toggled="OnSatelliteToggled" />
                <ToggleSwitch x:Name="ClockToggle" Header="Heure au repos" Toggled="OnClockToggled" />
                <ToggleSwitch x:Name="DiagnosticsToggle" Header="Diagnostics" Toggled="OnDiagnosticsToggled" />
                <ToggleSwitch
                    x:Name="CompositionToggle"
                    Header="Dissolution par le compositeur"
                    OnContent="Compositeur (référence)"
                    OffContent="Dégradé XAML (repli)"
                    Toggled="OnCompositionToggled" />

                <TextBlock
                    x:Name="StatusText"
                    FontSize="11"
                    Foreground="#E0A030"
                    TextWrapping="Wrap"
                    Margin="0,10,0,0" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Padding="20,10,20,16" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Rétablir les valeurs par défaut" Click="OnResetClicked" />
            <Button Grid.Column="1" Content="Ouvrir la configuration" Click="OnOpenConfigClicked" />
            <Button Grid.Column="2" Content="Ouvrir les greffons" Click="OnOpenPluginsClicked" HorizontalAlignment="Left" />
            <TextBlock
                x:Name="PathText"
                Grid.Column="3"
                FontSize="10"
                Foreground="#60FFFFFF"
                VerticalAlignment="Center"
                TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="4" Content="Fermer" Click="OnCloseClicked" />
        </Grid>
    </Grid>
</Window>
