<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests du greffon d'exemple.

    Ils appartiennent au greffon, pas à l'hôte : c'est la façon dont un auteur
    tiers vérifierait son propre code, en ne dépendant que de SpaceNotch.Core.

    Seule exception, assumée : la référence à SpaceNotch.Infrastructure sert à
    exécuter le chargeur de greffons réel sur l'assemblage compilé. C'est le seul
    moyen de prouver la chaîne complète — assemblage découvert, type instancié,
    fonctionnalité produite — et non seulement que la classe compile.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <!-- Référencé pour être compilé et copié dans la sortie des tests : le test de
         chargement déplace l'assemblage dans un dossier de greffons temporaire. -->
    <ProjectReference Include="..\..\samples\SpaceNotch.SamplePlugin.Weather\SpaceNotch.SamplePlugin.Weather.csproj" />
    <ProjectReference Include="..\..\src\SpaceNotch.Core\SpaceNotch.Core.csproj" />
    <ProjectReference Include="..\..\src\SpaceNotch.Infrastructure\SpaceNotch.Infrastructure.csproj" />
  </ItemGroup>

</Project>
